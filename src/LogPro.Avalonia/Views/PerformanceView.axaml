<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LogPro.ViewModels"
             xmlns:conv="using:LogPro.Avalonia.Converters"
             x:Class="LogPro.Avalonia.Views.PerformanceView"
             x:DataType="vm:ProfilerViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="Performance" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Start" Command="{Binding StartProfilingCommand}" IsEnabled="{Binding !IsProfiling}" Padding="16,8" />
          <Button Content="Stop" Command="{Binding StopProfilingCommand}" IsEnabled="{Binding IsProfiling}" Padding="16,8" />
          <Button Content="HUD" Click="OnHudClick" Padding="16,8" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="24" Spacing="12">
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="8">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="Android device" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice}" MinWidth="160" Margin="0,0,12,0">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="App package" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox ItemsSource="{Binding AvailablePackages}" Text="{Binding TargetPackage}" IsEditable="True" MinWidth="220" Margin="0,0,8,0" />
              <Button Content="Load apps" Command="{Binding RefreshPackagesCommand}" Margin="0,0,12,0" />
              <TextBlock Text="Interval ms" VerticalAlignment="Center" Margin="0,0,8,0" />
              <NumericUpDown Value="{Binding SampleIntervalMs}" Minimum="250" Maximum="10000" Width="90" Margin="0,0,12,0" />
              <Button Content="Mark event" Command="{Binding AddMarkerCommand}" Margin="0,0,8,0" />
              <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,8,0" />
              <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding ActiveTarget}" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Text="{Binding MetricAvailability}" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Text="{Binding ThermalAlert}" Foreground="{DynamicResource BrushWarn}" />
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Min avg FPS" VerticalAlignment="Center"/><NumericUpDown Value="{Binding MinimumAverageFps}" Minimum="1" Maximum="240" Width="70"/><TextBlock Text="Max memory growth MB" VerticalAlignment="Center"/><NumericUpDown Value="{Binding MaximumMemoryGrowthMb}" Minimum="1" Maximum="10000" Width="80"/><TextBlock Text="Max FPS regression %" VerticalAlignment="Center"/><NumericUpDown Value="{Binding AllowedFpsRegressionPercent}" Minimum="1" Maximum="100" Width="70"/></StackPanel>
            <TextBlock Text="{Binding PerformanceAlerts}" Foreground="{DynamicResource BrushWarn}" />
            <TextBlock Text="{Binding MemoryTrend}" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Text="{Binding SampleOverhead}" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Text="{Binding SessionVerdict}" FontWeight="Bold" />
            <TextBlock Text="{Binding BaselineComparison}" Foreground="{DynamicResource BrushTextSecondary}" />
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Pin this run as baseline" Command="{Binding PinBaselineCommand}"/><Button Content="Clear baseline" Command="{Binding ClearBaselineCommand}"/></StackPanel>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
          <Border Grid.Column="0" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="FPS" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
              <TextBlock Text="{Binding Fps, StringFormat='{}{0:F1}'}" Foreground="{DynamicResource BrushAccent}" FontSize="28" FontWeight="Bold" />
              <TextBlock Text="{Binding FrameP90Ms, StringFormat='p90 {0:F1} ms'}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="CPU" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
              <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0:F0}%'}" Foreground="{DynamicResource BrushAccent}" FontSize="28" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="MEMORY (PSS)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
              <TextBlock Text="{Binding PssKb, StringFormat='{}{0} KB'}" Foreground="{DynamicResource BrushAccent}" FontSize="28" FontWeight="Bold" />
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="EST. FRAME GAPS" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
              <TextBlock Text="{Binding JankDisplay}" Foreground="{DynamicResource BrushWarn}" FontSize="28" FontWeight="Bold" />
              <TextBlock Text="{Binding BatteryLevel, StringFormat='battery {0}%'}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="FPS" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FpsChartRange}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" />
            <Polyline Points="{Binding ChartSamples, Converter={x:Static conv:AppConverters.Sparkline}, ConverterParameter=fps}"
                      Stroke="{DynamicResource BrushAccent}" StrokeThickness="2" Width="600" Height="120" Stretch="Uniform" />
            <TextBlock Text="CPU %" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CpuChartRange}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" />
            <Polyline Points="{Binding ChartSamples, Converter={x:Static conv:AppConverters.Sparkline}, ConverterParameter=cpu}"
                      Stroke="{DynamicResource BrushWarn}" StrokeThickness="2" Width="600" Height="80" Stretch="Uniform" />
            <TextBlock Text="MEMORY MB" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="{Binding MemoryChartRange}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" />
            <Polyline Points="{Binding ChartSamples, Converter={x:Static conv:AppConverters.Sparkline}, ConverterParameter=mem}"
                      Stroke="{DynamicResource BrushMem}" StrokeThickness="2" Width="600" Height="80" Stretch="Uniform" />
            <TextBlock Text="{Binding History.Count, StringFormat='{}{0} samples'}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="6">
            <TextBlock Text="Timeline (UTC) · presentation gaps over two refresh periods are estimates" Foreground="{DynamicResource BrushTextSecondary}" />
            <ItemsControl ItemsSource="{Binding Markers}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <ItemsControl ItemsSource="{Binding History}" MaxHeight="180"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"/><TextBlock Text="{Binding Fps, StringFormat='FPS {0:F1}'}"/><TextBlock Text="{Binding CpuPercent, StringFormat='CPU {0:F1}%'}"/><TextBlock Text="{Binding PssKb, StringFormat='PSS {0} KB'}"/><TextBlock Text="{Binding ThermalStatus, StringFormat='thermal {0}'}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Recent runs" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding RecentRuns}" />
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Tier comparison seconds" VerticalAlignment="Center"/><NumericUpDown Value="{Binding ComparisonSeconds}" Minimum="3" Maximum="120" Width="75"/><Button Content="Compare online Android devices" Command="{Binding CompareDevicesCommand}" /><Button Content="Cancel" Command="{Binding CancelComparisonCommand}" /></StackPanel>
            <ItemsControl ItemsSource="{Binding TierResults}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Profile.Label}"/><TextBlock Text="{Binding AvgFps, StringFormat='avg FPS {0:F1}'}"/><TextBlock Text="{Binding HasSufficientData, StringFormat='data sufficient: {0}'}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
