<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LogPro.Avalonia.Views"
        x:Class="LogPro.Avalonia.Views.PaletteWindow"
        Title="Command Palette"
        Width="540" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushVoid}"
        ShowInTaskbar="False">
  <DockPanel Margin="12">
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top"
             Watermark="Type a command…" FontSize="15"
             Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}"
             Padding="12" Margin="0,0,0,10" />
    <ListBox x:Name="ResultsList" Background="Transparent" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="views:PaletteItem">
          <DockPanel Margin="4,6">
            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock DockPanel.Dock="Bottom" Text="↑↓ navigate · Enter run · Esc close"
               Foreground="{DynamicResource BrushTextMuted}" FontSize="10" Margin="4,8,0,0" />
  </DockPanel>
</Window>
