<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LogPro.ViewModels"
             xmlns:conv="using:LogPro.Avalonia.Converters"
             x:Class="LogPro.Avalonia.Views.StressTestView"
             x:DataType="vm:StressTestViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="Stress Test" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="■ STOP" Command="{Binding StopMonkeyCommand}" IsEnabled="{Binding IsRunning}" Padding="16,8" />
          <Button Content="▶ RUN MONKEY" Command="{Binding RunMonkeyCommand}" IsEnabled="{Binding CanRun}" Padding="16,8" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid ColumnDefinitions="360,*">
      <ScrollViewer Grid.Column="0" Padding="16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
        <StackPanel Spacing="8">
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding PlatformBadge}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
          <Button Content="Refresh apps" Command="{Binding RefreshAppsCommand}" IsEnabled="{Binding IsPlatformSupported}" />
          <TextBox Text="{Binding AppSearchQuery}" PlaceholderText="Search installed apps…" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
          <ListBox ItemsSource="{Binding FilteredApps}" SelectedItem="{Binding SelectedApp}" Height="180" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBox Text="{Binding TargetPackage}" PlaceholderText="Target package" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" FontFamily="Consolas, Menlo, monospace" />
          <Button Content="Check device and package" Command="{Binding CheckReadinessCommand}" />
          <TextBlock Text="{Binding ReadinessMessage}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
          <ComboBox ItemsSource="{Binding RunModes}" SelectedItem="{Binding RunMode}" />
          <TextBox Text="{Binding DurationSeconds}" PlaceholderText="Duration in seconds (30–7200)" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Balanced" Command="{Binding ApplyPresetCommand}" CommandParameter="Balanced" />
            <Button Content="Touch" Command="{Binding ApplyPresetCommand}" CommandParameter="Touch" />
            <Button Content="Nav" Command="{Binding ApplyPresetCommand}" CommandParameter="Navigation" />
            <Button Content="Safe" Command="{Binding ApplyPresetCommand}" CommandParameter="Safe" />
          </StackPanel>
          <CheckBox Content="Safe mode" IsChecked="{Binding SafeMode}" />
          <CheckBox Content="Automatically save artifacts" IsChecked="{Binding AutoSaveRuns}" />
          <CheckBox Content="Capture screenshot on failure" IsChecked="{Binding CaptureFailureScreenshot}" />
          <TextBlock Text="{Binding EstimatedDuration}" Foreground="{DynamicResource BrushTextSecondary}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Event count" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
            <TextBox Grid.Column="1" Width="120" Text="{Binding EventCount}" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Throttle (ms)" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
            <TextBox Grid.Column="1" Width="120" Text="{Binding ThrottleMs}" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
          </Grid>
          <TextBox Text="{Binding Seed}" PlaceholderText="Seed" />
          <TextBlock Text="Event mix (%)" Foreground="{DynamicResource BrushTextSecondary}" />
          <TextBox Text="{Binding PctTouch}" PlaceholderText="Touch %" />
          <TextBox Text="{Binding PctMotion}" PlaceholderText="Motion %" />
          <TextBox Text="{Binding PctTrackball}" PlaceholderText="Trackball %" />
          <TextBox Text="{Binding PctNav}" PlaceholderText="Navigation %" />
          <TextBox Text="{Binding PctSyskeys}" PlaceholderText="System keys %" />
          <TextBox Text="{Binding PctAppswitch}" PlaceholderText="App switch %" />
          <TextBlock Text="Compare with previous run" Foreground="{DynamicResource BrushTextSecondary}" />
          <ComboBox ItemsSource="{Binding RunHistory}" SelectedItem="{Binding SelectedBaselineRun}" />
          <TextBlock Text="{Binding ComparisonSummary}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>
      </ScrollViewer>
      <DockPanel Grid.Column="1" Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Content="Save" Command="{Binding SaveOutputCommand}" Padding="12,6" />
          <Button Content="Clear" Command="{Binding ClearOutputCommand}" Padding="12,6" />
          <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Foreground="{DynamicResource BrushAccent}" Margin="12,0,0,0" />
          <TextBlock Text="{Binding EventsInjected, StringFormat='events: {0}'}" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" />
          <TextBlock Text="{Binding CrashCount, StringFormat='crashes: {0}'}" VerticalAlignment="Center" Foreground="{DynamicResource BrushDanger}" />
          <TextBlock Text="{Binding AnrCount, StringFormat='ANRs: {0}'}" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="12">
          <TextBlock Text="{Binding LatestFps, StringFormat='FPS: {0}'}" />
          <TextBlock Text="{Binding LatestCpuPercent, StringFormat='CPU %: {0}'}" />
          <TextBlock Text="{Binding LatestPssKb, StringFormat='PSS KB: {0}'}" />
          <TextBlock Text="{Binding LatestThermalStatus, StringFormat='Thermal: {0}'}" />
        </StackPanel>
        <ScrollViewer>
          <TextBlock Text="{Binding Output}" Foreground="{DynamicResource BrushLogText}" FontFamily="Consolas, Menlo, monospace" FontSize="12" TextWrapping="NoWrap" />
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
