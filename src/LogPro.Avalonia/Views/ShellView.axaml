<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LogPro.ViewModels"
             xmlns:conv="using:LogPro.Avalonia.Converters"
             x:Class="LogPro.Avalonia.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <TextBlock Text="Shell" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="220" />
          <Button Content="Clear" Command="{Binding ClearOutputCommand}" Padding="12,6" />
        </StackPanel>
      </DockPanel>
    </Border>
    <DockPanel Margin="16">
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
        <TextBox Grid.Column="0" Text="{Binding CommandInput}" Watermark="adb shell dumpsys …" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" FontFamily="Consolas, Menlo, monospace" />
        <Button Grid.Column="1" Content="Execute" Command="{Binding ExecuteCommandCommand}" IsEnabled="{Binding IsExecuting, Converter={x:Static conv:AppConverters.InverseBool}}" Padding="16,6" />
      </Grid>
      <ScrollViewer>
        <TextBlock Text="{Binding ShellOutput}" Foreground="{DynamicResource BrushLogText}" FontFamily="Consolas, Menlo, monospace" FontSize="12" TextWrapping="NoWrap" />
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</UserControl>
