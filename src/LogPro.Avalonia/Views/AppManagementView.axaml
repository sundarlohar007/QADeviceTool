<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LogPro.ViewModels"
             xmlns:conv="using:LogPro.Avalonia.Converters"
             x:Class="LogPro.Avalonia.Views.AppManagementView"
             x:DataType="vm:AppManagementViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="Apps" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding PlatformNotice}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" Width="150" ToolTip.Tip="Target device">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Refresh" Command="{Binding RefreshAppsCommand}" IsEnabled="{Binding CanRefresh}" Padding="14,6" />
          <Button Content="Install" Command="{Binding InstallAppCommand}" IsEnabled="{Binding CanInstall}" Padding="14,6" />
          <Button Content="Uninstall" Command="{Binding UninstallAppCommand}" IsEnabled="{Binding CanUninstall}" ToolTip.Tip="User apps only; system and hidden apps are protected" Padding="14,6" />
          <Button Content="Force Stop" Command="{Binding ForceStopAppCommand}" IsEnabled="{Binding CanAndroidAction}" ToolTip.Tip="Android user apps only" Padding="14,6" />
          <Button Content="Clear Data" Command="{Binding ClearAppDataCommand}" IsEnabled="{Binding CanAndroidAction}" ToolTip.Tip="Android user apps only" Padding="14,6" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="16,8,16,0">
        <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Width="100" />
        <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search name or package" Width="190" />
        <CheckBox Content="Test APK (-t)" IsChecked="{Binding AllowTestApk}" IsEnabled="{Binding IsAndroid}" VerticalAlignment="Center" />
        <Button Content="Snapshot" Command="{Binding SnapshotInventoryCommand}" IsEnabled="{Binding CanExport}" />
        <Button Content="Compare" Command="{Binding CompareSnapshotCommand}" IsEnabled="{Binding CanCompare}" />
        <Button Content="Export CSV" Command="{Binding ExportInventoryCommand}" IsEnabled="{Binding CanExport}" />
        <Button Content="Details" Command="{Binding ViewAppDetailsCommand}" IsEnabled="{Binding SelectedApp, Converter={x:Static conv:AppConverters.NullToBool}}" />
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding FilteredApps}" SelectedItem="{Binding SelectedApp}" Background="Transparent" Margin="16">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,3">
              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" />
              <TextBlock Text="{Binding PackageId}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas, Menlo, monospace" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Version}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
                <TextBlock Text="{Binding Category}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Row="2" Padding="16,10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="CONSOLE" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Content="Clear" Command="{Binding ClearConsoleCommand}" Padding="12,6" />
            <Button Content="Cancel install" Command="{Binding CancelInstallCommand}" IsEnabled="{Binding IsInstalling}" Padding="12,6" />
            <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsLoading}" />
          </StackPanel>
          <ScrollViewer MaxHeight="160">
            <TextBlock Text="{Binding ConsoleOutput}" Foreground="{DynamicResource BrushLogText}" FontFamily="Consolas, Menlo, monospace" FontSize="11" />
          </ScrollViewer>
          <TextBox Text="{Binding DetailsText}" IsReadOnly="True" Height="110" PlaceholderText="Select an app and choose Details" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
