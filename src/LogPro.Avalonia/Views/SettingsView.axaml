<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LogPro.ViewModels"
             xmlns:models="using:LogPro.Models"
             xmlns:conv="using:LogPro.Avalonia.Converters"
             x:Class="LogPro.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion, StringFormat='v{0}'}" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
        <!-- Appearance -->
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="APPEARANCE" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Dark" Command="{Binding SwitchToDarkThemeCommand}" IsEnabled="{Binding IsDarkTheme, Converter={x:Static conv:AppConverters.InverseBool}}" Padding="16,6" />
              <Button Content="Light" Command="{Binding SwitchToLightThemeCommand}" IsEnabled="{Binding IsLightTheme, Converter={x:Static conv:AppConverters.InverseBool}}" Padding="16,6" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Sessions directory -->
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="SESSIONS DIRECTORY" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding SessionsDirectory}" IsReadOnly="True" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
              <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSessionsFolderCommand}" Padding="12,6" />
              <Button Grid.Column="2" Content="Open" Command="{Binding OpenSessionsFolderCommand}" Padding="12,6" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Log retention -->
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="LOG RETENTION" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="Old logs and completed sessions, including screenshots and recordings, are removed at startup." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{Binding LogRetentionOptions}" SelectedItem="{Binding SelectedLogRetention}" Width="220" />
              <Button Content="Save" Command="{Binding SaveLogRetentionCommand}" Padding="14,6" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Wireless -->
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="WIRELESS ADB" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding PairingIpPort}" PlaceholderText="IP:Port" Width="160" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
              <TextBox Text="{Binding PairingCode}" PasswordChar="●" PlaceholderText="Pairing code" Width="140" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
              <Button Content="Pair" Command="{Binding PairDeviceCommand}" IsEnabled="{Binding IsWirelessAvailable}" Padding="14,6" />
              <Button Content="Discover" Command="{Binding DiscoverPortsCommand}" IsEnabled="{Binding IsWirelessAvailable}" Padding="14,6" />
              <Button Content="Connect" Command="{Binding ConnectWirelessDeviceCommand}" IsEnabled="{Binding IsWirelessAvailable}" Padding="14,6" />
              <Button Content="Disconnect" Command="{Binding DisconnectWirelessDeviceCommand}" IsEnabled="{Binding IsWirelessAvailable}" Padding="14,6" />
            </StackPanel>
            <TextBox Text="{Binding ConnectionIpPort}" PlaceholderText="Connection IP:Port (different from pairing port)" Width="320" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding DiscoveredPorts}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
            <TextBlock Text="{Binding WirelessStatus}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Dependencies -->
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="DEPENDENCIES" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding ToolStatuses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                    <Ellipse Width="8" Height="8" Fill="{Binding IsInstalled, Converter={x:Static conv:AppConverters.InstalledToBrush}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left" Content="Re-check" Command="{Binding CheckDependenciesCommand}" Padding="14,6" />
            <TextBlock Text="If a device is missing, reconnect USB, approve debugging or trust on the device, then Re-check. Windows iOS USB also needs the Apple Mobile Device Service running." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
          </StackPanel>
        </Border>

        <!-- Data -->
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="DATA" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <TextBlock Text="Clearing keeps unrelated files in a custom Sessions folder and excludes active sessions." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Export My Data" Command="{Binding ExportMyDataCommand}" Padding="14,6" />
              <Button Content="Open Logs Folder" Command="{Binding OpenLogsFolderCommand}" Padding="14,6" />
              <Button Content="Clear All Data" Command="{Binding ClearAllDataCommand}" Padding="14,6" Foreground="{DynamicResource BrushDanger}" />
            </StackPanel>
            <TextBlock Text="{Binding ClearDataStatus}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
            <TextBlock Text="{Binding StorageSummary}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
            <ListBox ItemsSource="{Binding CleanupTargets}" Height="90" />
            <Button Content="Refresh Storage Inventory" Command="{Binding RefreshStorageInventoryCommand}" HorizontalAlignment="Left" Padding="14,6" />
          </StackPanel>
        </Border>

        <!-- Updates -->
        <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock Text="UPDATES" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
            <CheckBox Content="Check GitHub for updates at startup" IsChecked="{Binding CheckForUpdatesOnStartup}" />
            <Button Content="Check Now" Command="{Binding CheckForUpdatesCommand}" HorizontalAlignment="Left" Padding="14,6" />
            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Text="{Binding UpdateCheckDetails}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
            <ListBox ItemsSource="{Binding AvailableUpdates}" SelectedItem="{Binding SelectedUpdate}" Height="90">
              <ListBox.ItemTemplate><DataTemplate x:DataType="models:UpdateInfo"><TextBlock Text="{Binding ToolName}" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Install Selected" Command="{Binding ApplyUpdateCommand}" CommandParameter="{Binding SelectedUpdate}" Padding="14,6" />
              <Button Content="Skip Selected Version" Command="{Binding SkipUpdateCommand}" CommandParameter="{Binding SelectedUpdate}" Padding="14,6" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Rollback scrcpy" Command="{Binding RollbackToolCommand}" CommandParameter="scrcpy" Padding="14,6" />
              <Button Content="Rollback iOS tool" Command="{Binding RollbackToolCommand}" CommandParameter="pymobiledevice3" Padding="14,6" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
