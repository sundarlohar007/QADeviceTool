<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LogPro.ViewModels"
        xmlns:views="using:LogPro.Avalonia.Views"
        xmlns:conv="using:LogPro.Avalonia.Converters"
        x:Class="LogPro.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="LogPro"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:DashboardViewModel"><views:DashboardView /></DataTemplate>
    <DataTemplate DataType="vm:SessionViewModel"><views:SessionsView /></DataTemplate>
    <DataTemplate DataType="vm:DeviceViewModel"><views:DeviceView /></DataTemplate>
    <DataTemplate DataType="vm:AppManagementViewModel"><views:AppManagementView /></DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel"><views:ShellView /></DataTemplate>
    <DataTemplate DataType="vm:DeepLinkViewModel"><views:DeepLinkView /></DataTemplate>
    <DataTemplate DataType="vm:VitalsViewModel"><views:VitalsView /></DataTemplate>
    <DataTemplate DataType="vm:FileExplorerViewModel"><views:FileExplorerView /></DataTemplate>
    <DataTemplate DataType="vm:MacroViewModel"><views:MacroView /></DataTemplate>
    <DataTemplate DataType="vm:StressTestViewModel"><views:StressTestView /></DataTemplate>
    <DataTemplate DataType="vm:ProfilerViewModel"><views:PerformanceView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
  </Window.DataTemplates>

  <DockPanel Background="#0E0E12">
    <!-- Sidebar -->
    <Border DockPanel.Dock="Left" Width="220" Background="#141418" Padding="0,16,0,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,0,16,16" Spacing="4">
          <TextBlock Text="LogPro" FontSize="22" FontWeight="Bold" Foreground="#4FD1C5" />
          <TextBlock Text="Avalonia shell — phase 4b" FontSize="11" Foreground="#9AA0A6" />
        </StackPanel>

        <ScrollViewer>
          <StackPanel Spacing="2">
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="dashboard"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=dashboard}"
                         Content="Dashboard" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="sessions"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=sessions}"
                         Content="Sessions" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="device"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=device}"
                         Content="Devices" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="apps"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=apps}"
                         Content="Apps" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="files"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=files}"
                         Content="Files" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="shell"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=shell}"
                         Content="Shell" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="deeplink"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=deeplink}"
                         Content="Deep Link" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="vitals"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=vitals}"
                         Content="Vitals" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="macros"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=macros}"
                         Content="Macros" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="stresstest"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=stresstest}"
                         Content="Stress Test" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="performance"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=performance}"
                         Content="Performance" Padding="16,10" />
            <RadioButton Command="{Binding NavigateCommand}" CommandParameter="settings"
                         IsChecked="{Binding SelectedNavItem, Converter={x:Static conv:AppConverters.StringEquals}, ConverterParameter=settings}"
                         Content="Settings" Padding="16,10" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Content -->
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Background="#141418" Padding="16,6">
        <DockPanel>
          <TextBlock Text="{Binding StatusBarText}" Foreground="#9AA0A6" FontSize="11" />
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="16">
            <TextBlock Text="{Binding ConnectedDeviceCount, StringFormat='Devices: {0}'}" Foreground="#4FD1C5" FontSize="11" />
            <TextBlock Text="{Binding SelectedDevice.DisplayName}" Foreground="#9AA0A6" FontSize="11" />
          </StackPanel>
        </DockPanel>
      </Border>

      <ContentControl Content="{Binding CurrentView}" />
    </DockPanel>
  </DockPanel>
</Window>
