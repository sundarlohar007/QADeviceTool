<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LogPro.Avalonia.ViewModels"
        x:Class="LogPro.Avalonia.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="LogPro (Avalonia)"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:ShellViewModel />
  </Design.DataContext>

  <DockPanel>
    <!-- Sidebar -->
    <Border DockPanel.Dock="Left" Width="220" Background="#141418" Padding="16">
      <StackPanel Spacing="4">
        <TextBlock Text="LogPro" FontSize="22" FontWeight="Bold" Foreground="#4FD1C5" />
        <TextBlock Text="Cross-platform shell (Phase 4b)" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,16" />

        <RadioButton Content="Dashboard" IsChecked="True" />
        <RadioButton Content="Sessions" />
        <RadioButton Content="Devices" />
        <RadioButton Content="Performance" IsEnabled="False" />
        <RadioButton Content="Apps" />
        <RadioButton Content="Files" />
        <RadioButton Content="Automation" IsEnabled="False" />
        <RadioButton Content="Settings" />
      </StackPanel>
    </Border>

    <!-- Content -->
    <DockPanel Background="#0E0E12">
      <Border DockPanel.Dock="Top" Padding="24,20" BorderBrush="#232329" BorderThickness="0,0,0,1">
        <DockPanel>
          <StackPanel>
            <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold" Foreground="#E8EAED" />
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#9AA0A6" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="16">
            <TextBlock Text="{Binding DeviceCount, StringFormat='Devices: {0}'}" Foreground="#4FD1C5" />
            <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" Foreground="#9AA0A6" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Device list (live from the engine) -->
      <ScrollViewer Padding="24">
        <StackPanel Spacing="8">
          <TextBlock Text="CONNECTED DEVICES" FontSize="11" Foreground="#9AA0A6" />
          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#17171C" CornerRadius="8" Padding="14" Margin="0,2">
                  <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="#4ADE80" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}" Foreground="#E8EAED" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Serial}" Foreground="#9AA0A6" FontSize="11" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No devices connected. Connect a device via USB."
                     Foreground="#9AA0A6" FontSize="12" Margin="0,8,0,0"
                     IsVisible="{Binding !Devices.Count}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</Window>
