<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LogPro.ViewModels"
             xmlns:conv="using:LogPro.Avalonia.Converters"
             x:Class="LogPro.Avalonia.Views.DeviceView"
             x:DataType="vm:DeviceViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="Devices" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
          <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding DiscoveryMessage}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0" />
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshDevicesCommand}" Padding="14,6" />
      </DockPanel>
    </Border>
    <Grid ColumnDefinitions="300,*">
      <Border Grid.Column="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0" Padding="12">
        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4">
                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding MaskedSerial}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <ScrollViewer Grid.Column="1" Padding="24">
        <StackPanel Spacing="12">
          <TextBlock Text="DEVICE DETAILS" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CapabilityNotice}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Serial:" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Text="{Binding SelectedSerialDisplay}" Foreground="{DynamicResource BrushTextPrimary}" />
            <Button Content="{Binding SerialVisibilityActionText}" Command="{Binding ToggleSerialVisibilityCommand}" IsEnabled="{Binding HasSelectedDevice}" />
          </StackPanel>
          <TextBox Text="{Binding DeviceDetails}" IsReadOnly="True" AcceptsReturn="True" MinHeight="200" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" FontFamily="Consolas, Menlo, monospace" />
          <TextBlock Text="TAG" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
          <TextBox Text="{Binding DeviceTag}" IsEnabled="{Binding HasSelectedDevice}" PlaceholderText="Tag for this device" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
          <TextBlock Text="NOTES" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
          <TextBox Text="{Binding DeviceNotes}" IsEnabled="{Binding HasSelectedDevice}" PlaceholderText="Notes for this device" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" />
          <WrapPanel>
            <Button Margin="0,0,8,0" Content="Save Notes" Command="{Binding SaveDeviceNotesCommand}" IsEnabled="{Binding HasSelectedDevice}" Padding="14,6" />
            <Button Margin="0,0,8,0" Content="Mirror" Command="{Binding StartMirrorCommand}" IsEnabled="{Binding CanMirror}" Padding="14,6" />
            <Button Margin="0,0,8,0" Content="Stop Mirror" Command="{Binding StopMirrorCommand}" IsEnabled="{Binding IsMirroring}" Padding="14,6" />
            <Button Margin="0,0,8,0" Content="Snapshot" Command="{Binding TakeSnapshotCommand}" IsEnabled="{Binding CanTakeSnapshot}" Padding="14,6" />
            <Button Margin="0,0,8,0" Content="Open Snapshot Folder" Command="{Binding OpenSnapshotFolderCommand}" IsEnabled="{Binding HasSnapshotDirectory}" Padding="14,6" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
