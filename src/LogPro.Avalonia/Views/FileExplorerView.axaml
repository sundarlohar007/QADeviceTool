<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LogPro.ViewModels"
             xmlns:conv="using:LogPro.Avalonia.Converters"
             x:Class="LogPro.Avalonia.Views.FileExplorerView"
             x:DataType="vm:FileExplorerViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <TextBlock Text="File Explorer" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="14,6" />
          <Button Content="Upload" Command="{Binding UploadFileCommand}" IsEnabled="{Binding SelectedFile, Converter={x:Static conv:AppConverters.NullToBool}}" Padding="14,6" />
          <Button Content="Download" Command="{Binding DownloadFileCommand}" IsEnabled="{Binding SelectedFile, Converter={x:Static conv:AppConverters.NullToBool}}" Padding="14,6" />
          <Button Content="Delete" Command="{Binding DeleteFileCommand}" IsEnabled="{Binding SelectedFile, Converter={x:Static conv:AppConverters.NullToBool}}" Padding="14,6" />
        </StackPanel>
      </DockPanel>
    </Border>
    <DockPanel Margin="16">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
        <Button Grid.Column="0" Content="↑" Command="{Binding NavigateUpCommand}" Padding="10,4" />
        <TextBox Grid.Column="1" Text="{Binding CurrentPath}" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" FontFamily="Consolas, Menlo, monospace" />
        <Button Grid.Column="2" Content="Go" Command="{Binding NavigateToPathCommand}" Padding="14,4" />
      </Grid>
      <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
      </Border>
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,3">
              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" />
              <TextBlock Text="{Binding DisplaySize}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>
