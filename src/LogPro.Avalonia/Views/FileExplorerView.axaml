<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LogPro.ViewModels"
             xmlns:conv="using:LogPro.Avalonia.Converters"
             x:Class="LogPro.Avalonia.Views.FileExplorerView"
             x:DataType="vm:FileExplorerViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="24,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
      <DockPanel>
        <TextBlock Text="File Explorer" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice}" Width="180">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="14,6" />
          <Button Content="Upload" Command="{Binding UploadFileCommand}" IsEnabled="{Binding SelectedDevice, Converter={x:Static conv:AppConverters.NullToBool}}" Padding="14,6" />
          <Button Content="Download" Command="{Binding DownloadFileCommand}" IsEnabled="{Binding CanUseSelectedFile}" Padding="14,6" />
          <Button Content="Delete" Command="{Binding DeleteFileCommand}" IsEnabled="{Binding CanUseSelectedFile}" Padding="14,6" />
        </StackPanel>
      </DockPanel>
    </Border>
    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <ItemsControl ItemsSource="{Binding Breadcrumbs}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Tag="{Binding}" Click="Breadcrumb_Click" Margin="0,0,4,0" /></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Button Grid.Column="0" Content="↑" Command="{Binding NavigateUpCommand}" Padding="10,4" />
        <TextBox Grid.Column="1" Text="{Binding PathInput}" Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" FontFamily="Consolas, Menlo, monospace" />
        <Button Grid.Column="2" Content="Go" Command="{Binding NavigateToPathCommand}" Padding="14,4" />
      </Grid>
      <TextBox Text="{Binding FilterText}" PlaceholderText="Filter files in this folder" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Loading..." IsVisible="{Binding IsLoading}" />
        <TextBlock Text="Transfer in progress..." IsVisible="{Binding IsTransferring}" />
        <Button Content="Cancel transfer" Command="{Binding CancelTransferCommand}" IsEnabled="{Binding IsTransferring}" />
      </StackPanel>
      <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Transfers}">
          <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding Description}" /><TextBlock Text="{Binding State}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel IsVisible="{Binding IsIosDevice}" Spacing="6">
        <TextBlock Text="iOS app documents" FontWeight="Bold" />
        <TextBlock Text="{Binding AppAccessNotice}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Load apps" Command="{Binding LoadIosAppsCommand}" />
          <ComboBox ItemsSource="{Binding AvailableApps}" SelectedItem="{Binding SelectedApp}" Width="220">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <TextBox Text="{Binding AppRemotePath}" PlaceholderText="Remote path under /Documents/" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Download document" Command="{Binding DownloadAppDocumentCommand}" />
          <Button Content="Upload document" Command="{Binding UploadAppDocumentCommand}" />
        </StackPanel>
      </StackPanel>
      </StackPanel>
      <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
      </Border>
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" DoubleTapped="Files_DoubleTapped" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,3">
              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" />
              <TextBlock Text="{Binding DisplaySize}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</UserControl>
