<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>logpro-cli</AssemblyName>
    <RootNamespace>LogPro.Cli</RootNamespace>
    <Description>Headless CLI for the LogPro engine — device listing, log capture, export, bug reports. CI/scripting surface.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogPro.Core\LogPro.Core.csproj" />
  </ItemGroup>

</Project>
