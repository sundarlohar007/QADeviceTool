<UserControl x:Class="LogPro.Views.MacroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels"
             xmlns:conv="clr-namespace:LogPro.Converters">
    <Grid Margin="24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Device List -->
        <Border Grid.Column="0" Style="{StaticResource AppleCard}" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Device" Style="{StaticResource TextHeading3}" Margin="0,0,0,12" />
                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                         Style="{StaticResource DarkListBox}" DisplayMemberPath="DisplayName" />
            </DockPanel>
        </Border>

        <!-- Macro Controls -->
        <Border Grid.Column="1" Style="{StaticResource AppleCard}" Margin="8,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Input Macros" Style="{StaticResource TextHeading3}" Margin="0,0,0,8" />

                    <!-- Record/Playback Controls -->
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Record" Command="{Binding ToggleRecordingCommand}"
                                Margin="0,0,6,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushRed}" />
                                            <Setter Property="Content" Value="Stop Rec" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Content="Play"
                                Command="{Binding PlayMacroCommand}"
                                IsEnabled="{Binding IsPlaying, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                                Margin="0,0,6,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                                Command="{Binding StopPlaybackCommand}"
                                Margin="0,0,6,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Delete"
                                Command="{Binding DeleteMacroCommand}"
                                Margin="0,0,6,6" />
                    </WrapPanel>

                    <!-- Speed & Loop -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Speed:" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,6,0" />
                        <Slider Width="100" Minimum="0.5" Maximum="5" Value="{Binding PlaybackSpeed}"
                                TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding PlaybackSpeed, StringFormat={}{0:F1}x}"
                                   VerticalAlignment="Center" FontSize="11" Width="30"
                                   Foreground="{StaticResource BrushCyan}" Margin="0,0,12,0" />
                        <TextBlock Text="Loop:" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,6,0" />
                        <TextBox Text="{Binding LoopCount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Width="50" TextAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushAccent}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                </StackPanel>

                <!-- Macro Library -->
                <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}"
                         Style="{StaticResource DarkListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="{Binding DisplayInfo}" FontSize="10"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
