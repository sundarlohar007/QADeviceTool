<UserControl x:Class="LogPro.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24">

            <TextBlock Text="Settings" Style="{StaticResource TextHeading1}" Margin="0,0,0,24" />

            <!-- Tool Dependencies -->
            <Border Style="{StaticResource AppleCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Dependency Status" Style="{StaticResource TextHeading3}" />
                        <Button Style="{StaticResource TertiaryButton}" Content="Re-check"
                                Command="{Binding CheckDependenciesCommand}"
                                Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextBody}" Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding ToolStatuses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBackgroundPrimary}"
                                        CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}"
                                                   FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       Foreground="{StaticResource BrushTextPrimary}"
                                                       FontSize="14" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" />
                                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextBody}"
                                                       Margin="0,4,0,0" FontSize="12" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Version}"
                                                   Style="{StaticResource TextMono}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <TextBlock Grid.Column="3" 
                                                   Text="{Binding Path}" 
                                                   Style="{StaticResource TextCaption}"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Sessions Directory -->
            <Border Style="{StaticResource AppleCard}">
                <StackPanel>
                    <TextBlock Text="Sessions Directory" Style="{StaticResource TextHeading3}" Margin="0,0,0,10" />
                    <TextBlock Text="Log sessions and screenshots are saved here:"
                               Style="{StaticResource TextBody}" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding SessionsDirectory}"
                                 Style="{StaticResource DarkTextBox}" IsReadOnly="True" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Content="Browse" Command="{Binding BrowseSessionsFolderCommand}"
                                Margin="8,0,0,0" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Content="Open" Command="{Binding OpenSessionsFolderCommand}"
                                Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Log Retention -->
            <Border Style="{StaticResource AppleCard}">
                <StackPanel>
                    <TextBlock Text="Log Retention" Style="{StaticResource TextHeading3}" Margin="0,0,0,10" />
                    <TextBlock Text="Automatically delete logs older than:"
                               Style="{StaticResource TextBody}" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" 
                                  ItemsSource="{Binding LogRetentionOptions}"
                                  SelectedItem="{Binding SelectedLogRetention}"
                                  DisplayMemberPath="Text"
                                  SelectedValuePath="Value"
                                  Width="180" />
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Content="Save" Command="{Binding SaveLogRetentionCommand}"
                                Margin="12,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Wireless ADB Pairing -->
            <Border Style="{StaticResource AppleCard}">
                <StackPanel>
                    <TextBlock Text="Wireless ADB Pairing" Style="{StaticResource TextHeading3}" Margin="0,0,0,12" />
                    <TextBlock Text="Connect Android devices wirelessly via WiFi. Enable wireless debugging on your device (Settings > Developer Options)."
                               Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="IP:Port" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PairingIpPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Pairing Code" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource PrimaryButton}" Content="Pair" 
                                    Command="{Binding PairDeviceCommand}" Width="80" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource SecondaryButton}" Content="Discover" 
                                Command="{Binding DiscoverPortsCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Connect" 
                                Command="{Binding ConnectWirelessDeviceCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource TertiaryButton}" Content="Disconnect" 
                                Command="{Binding DisconnectWirelessDeviceCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Discovered: " Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding DiscoveredPorts}" Style="{StaticResource TextMono}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Status: " Style="{StaticResource TextCaption}" />
                        <TextBlock Text="{Binding WirelessStatus}" Style="{StaticResource TextBody}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Data Management -->
            <Border Style="{StaticResource AppleCard}">
                <StackPanel>
                    <TextBlock Text="Data Management" Style="{StaticResource TextHeading3}" Margin="0,0,0,10" />
                    <TextBlock Text="Clear all application data including preferences and logs:"
                               Style="{StaticResource TextBody}" Margin="0,0,0,10" />

                    <Button Style="{StaticResource DangerButton}"
                            Content="Clear All Data"
                            Command="{Binding ClearAllDataCommand}"
                            HorizontalAlignment="Left" />
                    
                    <TextBlock Text="{Binding ClearDataStatus}" 
                               Style="{StaticResource TextCaption}" 
                               Margin="0,8,0,0"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource AppleCard}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource TextHeading3}" Margin="0,0,0,16" />

                    <TextBlock Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4">
                        LogPro
                    </TextBlock>
                    <TextBlock Style="{StaticResource TextBody}" Margin="0,0,0,16">
                        <Run Text="Version " /><Run Text="{Binding AppVersion}" />
                    </TextBlock>

                    <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,0,0,20" LineHeight="22">
                        A Windows QA/QC utility for manual game testers. Supports Android &amp; iOS device log capture, session management, screen mirroring, and device snapshots.
                    </TextBlock>

                    <!-- Developer -->
                    <Border Background="{StaticResource BrushBackgroundPrimary}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Developer" Foreground="{StaticResource BrushTextTertiary}" FontSize="11" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBlock Text="Sundar Lohar" Foreground="{StaticResource BrushTextPrimary}" FontSize="14" FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                    <!-- Reach Out -->
                    <Border Background="{StaticResource BrushBackgroundPrimary}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Reach Out" Foreground="{StaticResource BrushTextTertiary}" FontSize="11" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBlock Foreground="{StaticResource BrushAccent}" FontSize="13" Cursor="Hand">
                                <Hyperlink NavigateUri="https://github.com/sundarlohar007" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource BrushAccent}" TextDecorations="None">
                                    github.com/sundarlohar007
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource BrushAccent}" FontSize="13" Margin="0,4,0,0">
                                sundar.lohar@ubisoft.com
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Third-Party Software -->
                    <Border Background="{StaticResource BrushBackgroundPrimary}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Third-Party Software" Foreground="{StaticResource BrushTextTertiary}" FontSize="11" FontWeight="Medium" Margin="0,0,0,8" />
                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="18">
                                This application bundles the following open-source software (see 'licenses' folder):
                            </TextBlock>
                            
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="scrcpy" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="Apache License 2.0" Foreground="{StaticResource BrushTextTertiary}" FontSize="12" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="pymobiledevice3" Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="GNU GPL v3" Foreground="{StaticResource BrushTextTertiary}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Powered By -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="Powered by " Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                        <TextBlock Text="AntiGravity" 
                                   Foreground="{StaticResource BrushAccent}" 
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
