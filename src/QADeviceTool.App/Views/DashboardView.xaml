<UserControl x:Class="LogPro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24">

            <!-- Welcome Header -->
            <TextBlock Text="Dashboard" Style="{StaticResource TextHeading1}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding WelcomeMessage}" Style="{StaticResource TextBody}" Margin="0,0,0,28" />

            <!-- Connected Devices -->
            <Border Style="{StaticResource AppleCard}">
                <StackPanel>
                    <TextBlock Text="Connected Devices" Style="{StaticResource TextHeading3}" Margin="0,0,0,16" />
                    <TextBlock Text="No devices connected. Connect a device via USB." Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource AppleCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Quick Actions" Style="{StaticResource TextHeading3}" Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="Mirror Screen"
                                Command="{Binding QuickMirrorCommand}" Margin="0,0,10,10" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Snapshot"
                                Command="{Binding QuickSnapshotCommand}" Margin="0,0,10,10" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Refresh Devices"
                                Command="{Binding RefreshDevicesCommand}" Margin="0,0,10,10" />
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>