<UserControl x:Class="LogPro.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels"
             xmlns:models="clr-namespace:LogPro.Models"
             xmlns:conv="clr-namespace:LogPro.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:LogLevelColorMultiConverter x:Key="LogLevelColorConverter" />
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: Session List -->
        <Border Grid.Column="0" Style="{StaticResource AppleCard}" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sessions" Style="{StaticResource TextHeading3}" Margin="0,0,0,12" />

                <!-- New session controls -->
                <Border DockPanel.Dock="Top" Background="{StaticResource BrushBackgroundPrimary}"
                        CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Device selector -->
                        <TextBlock Text="Select Device" 
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="11" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableDevices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="0,0,0,8" />

                        <!-- Optional custom name -->
                        <TextBlock Text="Session name (optional)" 
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="11" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding NewSessionName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="+ New Session"
                                    Command="{Binding CreateSessionCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Open Folder"
                                    Command="{Binding OpenSessionFolderCommand}" />
                        </StackPanel>

                        <!-- Auto-capture toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox IsChecked="{Binding AutoCapture}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Auto-start when device connected"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Session list -->
                <ListBox ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession}"
                         Style="{StaticResource DarkListBox}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseRightButtonUp="SessionList_MouseRightButtonUp">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListBoxItem}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open Directory" Click="OpenDirectory_Click" />
                            <Separator Background="{StaticResource BrushSeparator}" Margin="0,4" />
                            <MenuItem Header="Delete Session" Click="DeleteSession_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="13" FontWeight="Medium"
                                           Text="{Binding Name}" />
                                <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11"
                                           Text="{Binding DurationText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- RIGHT: Log Viewer -->
        <Border Grid.Column="1" Style="{StaticResource AppleCard}" Margin="8,0,0,0">
            <DockPanel>
                <!-- Header with actions -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Live Log" Style="{StaticResource TextHeading3}" Margin="0,0,0,12" />
                    
                    <!-- Primary Actions -->
                    <WrapPanel Margin="0,0,0,8">
                        <Button Style="{StaticResource PrimaryButton}" Content="Start"
                                Command="{Binding StartCaptureCommand}"
                                Margin="0,0,6,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Stop"
                                Command="{Binding StopCaptureCommand}"
                                Margin="0,0,6,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Save"
                                Command="{Binding SaveLogCommand}"
                                Margin="0,0,6,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Copy All"
                                Command="{Binding CopyToClipboardCommand}"
                                Margin="0,0,6,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Snap"
                                Command="{Binding TakeSnapshotCommand}"
                                Margin="0,0,6,6" />
                        <Button Command="{Binding ToggleScreenRecordCommand}"
                                Margin="0,0,6,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Content" Value="Record" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScreenRecording}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushRed}" />
                                            <Setter Property="Content" Value="Stop Rec" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Content="Report"
                                Command="{Binding GenerateBugReportCommand}"
                                Margin="0,0,6,6" />
                    </WrapPanel>

                    <!-- Secondary Actions -->
                    <WrapPanel>
                        <Button Style="{StaticResource SecondaryButton}" Content="Export CSV"
                                Command="{Binding ExportCsvCommand}"
                                Margin="0,0,6,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Export JSON"
                                Command="{Binding ExportJsonCommand}"
                                Margin="0,0,6,6" />
                        <CheckBox Content="Anonymize"
                                  IsChecked="{Binding AnonymizeExport}"
                                  Foreground="{StaticResource BrushTextSecondary}"
                                  VerticalAlignment="Center"
                                  Margin="8,0,6,6" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Clear"
                                Command="{Binding ClearLogCommand}"
                                Margin="0,0,6,6" />
                    </WrapPanel>
                </StackPanel>

                <!-- Status message -->
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" 
                           Foreground="{StaticResource BrushAccent}"
                           FontSize="12" Margin="0,0,0,6" />

                <!-- Filters -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 Style="{StaticResource DarkTextBox}" Width="160" Margin="0,0,12,0" />
                    </StackPanel>

                    <!-- Log Buffer & Format -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                        <TextBlock Text="Buf:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="0,0,4,0" />
                        <ComboBox Width="75" FontSize="10" Height="22"
                                  SelectedItem="{Binding SelectedLogBuffer, Mode=TwoWay}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type models:LogcatBuffer}">
                                    <models:LogcatBuffer>Main</models:LogcatBuffer>
                                    <models:LogcatBuffer>System</models:LogcatBuffer>
                                    <models:LogcatBuffer>Events</models:LogcatBuffer>
                                    <models:LogcatBuffer>Crash</models:LogcatBuffer>
                                    <models:LogcatBuffer>Radio</models:LogcatBuffer>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>
                        <TextBlock Text="Fmt:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="8,0,4,0" />
                        <ComboBox Width="85" FontSize="10" Height="22"
                                  SelectedItem="{Binding SelectedLogFormat, Mode=TwoWay}">
                            <ComboBox.ItemsSource>
                                <x:Array Type="{x:Type models:LogcatFormat}">
                                    <models:LogcatFormat>ThreadTime</models:LogcatFormat>
                                    <models:LogcatFormat>Time</models:LogcatFormat>
                                    <models:LogcatFormat>Brief</models:LogcatFormat>
                                    <models:LogcatFormat>Process</models:LogcatFormat>
                                    <models:LogcatFormat>Tag</models:LogcatFormat>
                                    <models:LogcatFormat>Thread</models:LogcatFormat>
                                    <models:LogcatFormat>Long</models:LogcatFormat>
                                    <models:LogcatFormat>Raw</models:LogcatFormat>
                                </x:Array>
                            </ComboBox.ItemsSource>
                        </ComboBox>
                    </StackPanel>

                    <!-- Toggles + Bookmarks -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <ToggleButton x:Name="ColorToggle" Content="Color" IsChecked="{Binding IsColorCodingEnabled}"
                                      Style="{StaticResource FilterToggleButton}" />
                        <ToggleButton x:Name="ParseToggle" Content="Parse" IsChecked="{Binding IsRawMode, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                                      Style="{StaticResource FilterToggleButton}" />
                        <ToggleButton x:Name="ScrollToggle" Content="Scroll" IsChecked="{Binding IsAutoScrollEnabled}"
                                      Style="{StaticResource FilterToggleButton}" />
                    </StackPanel>
                </Grid>

                <!-- Log viewer -->
                <ListView x:Name="LogDataGrid"
                          ItemsSource="{Binding LogEntriesView}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          Background="{StaticResource BrushVoid}"
                          BorderBrush="{StaticResource BrushBorder}"
                          BorderThickness="1"
                          FontFamily="{StaticResource FontMono}"
                          FontSize="11">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="logBorder" Padding="8,1" CornerRadius="0">
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource LogLevelColorConverter}" ConverterParameter="Background">
                                        <Binding Path="Level" />
                                        <Binding Path="DataContext.IsColorCodingEnabled" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                    </MultiBinding>
                                </Border.Background>
                                <TextBlock Text="{Binding RawLine}"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="11">
                                    <TextBlock.Foreground>
                                        <MultiBinding Converter="{StaticResource LogLevelColorConverter}" ConverterParameter="Foreground">
                                            <Binding Path="Level" />
                                            <Binding Path="DataContext.IsColorCodingEnabled" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>