<UserControl x:Class="LogPro.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels"
             xmlns:conv="clr-namespace:LogPro.Converters">

    <Grid Margin="24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: Device List -->
        <Border Grid.Column="0" Style="{StaticResource AppleCard}" Margin="0,0,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Devices" Style="{StaticResource TextHeading3}" Margin="0,0,0,10" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Refresh"
                            Command="{Binding RefreshDevicesCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="No devices detected. Connect via USB."
                           Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox ItemsSource="{Binding Devices}"
                         SelectedItem="{Binding SelectedDevice}"
                         Style="{StaticResource DarkListBox}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
<ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListBoxItem}" />
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PlatformIcon}" FontSize="20" 
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" 
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               FontSize="13" FontWeight="Medium" />
                                    <TextBlock Text="{Binding Serial}" Style="{StaticResource TextCaption}" />
                                    
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Connected">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="Offline">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- RIGHT: Device Details & Actions -->
        <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">

                <!-- Device Info Card -->
                <Border Style="{StaticResource AppleCard}">
                    <StackPanel>
                        <TextBlock Text="Device Details" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding DeviceDetails}"
                                   Style="{StaticResource TextMono}"
                                   LineHeight="22"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Device Notes Card -->
                <Border Style="{StaticResource AppleCard}">
                    <StackPanel>
                        <TextBlock Text="Device Notes &amp; Tags" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                        
                        <TextBlock Text="Tag (e.g., 'Test Device 1')" 
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DeviceTag, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"
                                 Margin="0,0,0,10" />
                        
                        <TextBlock Text="Notes" 
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DeviceNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}"
                                 Height="80"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,10" />
                        
                        <Button Style="{StaticResource SecondaryButton}" Content="Save Notes"
                                Command="{Binding SaveDeviceNotesCommand}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Actions Card -->
                <Border Style="{StaticResource AppleCard}">
                    <StackPanel>
                        <TextBlock Text="Actions" Style="{StaticResource SectionHeader}" Margin="0,0,0,14" />

                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="Mirror Screen"
                                    Command="{Binding StartMirrorCommand}" Margin="0,0,8,8" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Stop Mirror"
                                    Command="{Binding StopMirrorCommand}" Margin="0,0,8,8" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Take Snapshot"
                                    Command="{Binding TakeSnapshotCommand}" Margin="0,0,8,8" />
                        </WrapPanel>

                        <!-- Status message -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource TextBody}"
                                   Foreground="{StaticResource BrushAccent}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Wireless ADB -->
                <Border Style="{StaticResource AppleCard}">
                    <StackPanel>
                        <TextBlock Text="Wireless ADB (Android)" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />
                        <TextBlock Text="Connect to Android devices over Wi-Fi. First connect via USB, click Enable, then unplug USB and click Connect."
                                   Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding WirelessIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" />
                            <TextBlock Grid.Column="0" Text="Device IP Address"
                                       Foreground="{StaticResource BrushTextTertiary}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WirelessIpAddress, Converter={x:Static conv:NullToBoolConverter.Instance}}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <WrapPanel>
                            <Button Style="{StaticResource PrimaryButton}" Content="Enable Wireless"
                                    Command="{Binding EnableWirelessCommand}"
                                    Margin="0,0,8,8" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Connect"
                                    Command="{Binding ConnectWirelessCommand}"
                                    Margin="0,0,8,8" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Disconnect"
                                    Command="{Binding DisconnectWirelessCommand}"
                                    Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- iOS Note -->
                <Border Style="{StaticResource AppleCard}">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource Amber}" Opacity="0.12" />
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="iOS Screen Mirroring" 
                                   Foreground="{StaticResource BrushWarning}"
                                   FontSize="14" FontWeight="Medium" Margin="0,0,0,6" />
                        <TextBlock Text="Screen mirroring for iOS devices is not supported on Windows. Use AirPlay or a Mac-based tool for iOS mirroring."
                                   Style="{StaticResource TextBody}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
