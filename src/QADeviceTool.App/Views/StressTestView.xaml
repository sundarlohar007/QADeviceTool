<UserControl x:Class="LogPro.Views.StressTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left: config panel ── -->
        <Border Grid.Column="0" Style="{StaticResource AppleCard}" Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Section: device + app -->
                    <TextBlock Text="Target" Style="{StaticResource TextHeading3}" Margin="0,0,0,8" />

                    <TextBlock Text="Device:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="DisplayName"
                              Margin="0,4,0,4" />
                    <TextBlock Text="{Binding PlatformBadge}"
                               Foreground="{StaticResource BrushAccent}"
                               FontSize="11" Margin="0,0,0,8" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="App (search by name or package):"
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                        <Button Grid.Column="1" Content="↻"
                                Command="{Binding RefreshAppsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,2" FontSize="11"
                                ToolTip="Reload installed apps from device"
                                IsEnabled="{Binding IsPlatformSupported}" />
                    </Grid>
                    <TextBox Text="{Binding AppSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}"
                             Margin="0,4,0,2"
                             IsEnabled="{Binding IsPlatformSupported}" />
                    <TextBlock Text="Loading..." Foreground="{StaticResource BrushAccent}" FontSize="10"
                               Visibility="{Binding IsLoadingApps, Converter={StaticResource BoolToVis}}" />
                    <ListBox ItemsSource="{Binding FilteredApps}"
                             SelectedItem="{Binding SelectedApp}"
                             MaxHeight="120" Margin="0,2,0,4"
                             FontSize="11"
                             Background="{StaticResource BrushBackgroundPrimary}"
                             Foreground="{StaticResource BrushTextPrimary}"
                             BorderBrush="{StaticResource BrushBorder}"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding PackageId}" FontSize="10"
                                               Foreground="{StaticResource BrushTextTertiary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Resolved Package:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,4,0,0" />
                    <TextBox Text="{Binding TargetPackage, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,4,0,12"
                             ToolTip="Auto-filled when you pick from the list above. You can also type/paste manually." />

                    <!-- Section: run config -->
                    <TextBlock Text="Run Config" Style="{StaticResource TextHeading3}" Margin="0,4,0,8" />

                    <TextBlock Text="Event Count:" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                    <TextBox Text="{Binding EventCount, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,4,0,8" />
                    <TextBlock Text="Seed (0 = random):" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                    <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,4,0,8" />
                    <TextBlock Text="Throttle (ms):" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                    <TextBox Text="{Binding ThrottleMs, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,4,0,12" />

                    <!-- Section: percentages -->
                    <TextBlock Text="Event Mix (%)" Style="{StaticResource TextHeading3}" Margin="0,4,0,4" />
                    <Grid Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Touch" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PctTouch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontSize="11" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Motion" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PctMotion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontSize="11" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Trackball" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PctTrackball, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontSize="11" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nav" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PctNav, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontSize="11" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="SysKeys" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PctSyskeys, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontSize="11" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="AppSwitch" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding PctAppswitch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" FontSize="11" />
                    </Grid>

                    <!-- Section: actions -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource PrimaryButton}"
                                Content="▶ Run Monkey"
                                Command="{Binding RunMonkeyCommand}"
                                IsEnabled="{Binding CanRun}"
                                Margin="0,0,4,0" />
                        <Button Grid.Column="1"
                                Style="{StaticResource DangerButton}"
                                Content="■ Stop"
                                Command="{Binding StopMonkeyCommand}"
                                IsEnabled="{Binding IsRunning}"
                                Margin="4,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource BrushAccent}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Right: live output panel ── -->
        <Border Grid.Column="1" Style="{StaticResource AppleCard}" Margin="8,0,0,0">
            <DockPanel>
                <!-- Header -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Monkey Output" Style="{StaticResource TextHeading3}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrushBackgroundPrimary}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock FontSize="11">
                                <Run Text="Events: " Foreground="{StaticResource BrushTextTertiary}" />
                                <Run Text="{Binding EventsInjected, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                <Run Text=" / " Foreground="{StaticResource BrushTextTertiary}" />
                                <Run Text="{Binding EventCount, Mode=OneWay}" Foreground="{StaticResource BrushTextSecondary}" />
                            </TextBlock>
                        </Border>
                        <Border Background="{StaticResource BrushBackgroundPrimary}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock FontSize="11">
                                <Run Text="Crashes: " Foreground="{StaticResource BrushTextTertiary}" />
                                <Run Text="{Binding CrashCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource BrushDanger}" />
                            </TextBlock>
                        </Border>
                        <Border Background="{StaticResource BrushBackgroundPrimary}" CornerRadius="4" Padding="6,2">
                            <TextBlock FontSize="11">
                                <Run Text="ANRs: " Foreground="{StaticResource BrushTextTertiary}" />
                                <Run Text="{Binding AnrCount, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource BrushWarning}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Content="Save"
                                Command="{Binding SaveOutputCommand}" FontSize="11" Padding="8,2" Margin="0,0,4,0"
                                ToolTip="Save output to sessions directory" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Clear"
                                Command="{Binding ClearOutputCommand}" FontSize="11" Padding="8,2" />
                    </StackPanel>
                </Grid>

                <!-- Progress bar -->
                <ProgressBar DockPanel.Dock="Top"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Maximum="100" Height="4" Margin="0,0,0,8"
                             Foreground="{StaticResource BrushAccent}"
                             Background="{StaticResource BrushBackgroundPrimary}" />

                <!-- Live output -->
                <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                         Style="{StaticResource DarkTextBox}"
                         FontFamily="{StaticResource FontMono}" FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" AcceptsReturn="True" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
