<Window x:Class="LogPro.Views.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        Width="580" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.15"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="1" To="0" Duration="0:0:0.1"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="{StaticResource BrushBackgroundSurface}" 
            BorderBrush="{StaticResource BrushSeparator}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Input -->
            <TextBox x:Name="SearchBox"
                     Grid.Row="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="15"
                     FontFamily="{StaticResource FontPrimary}"
                     Background="Transparent"
                     Foreground="{StaticResource BrushTextPrimary}"
                     CaretBrush="{StaticResource BrushAccent}"
                     BorderThickness="0"
                     Padding="8,10"
                     Margin="0,0,0,10"/>

            <!-- Results List -->
            <ListBox x:Name="ResultsList"
                     Grid.Row="1"
                     ItemsSource="{Binding FilteredCommands}"
                     SelectedItem="{Binding SelectedCommand}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushFillQuaternary}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushFillTertiary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" 
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource BrushAccent}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" 
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Description}" 
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           FontSize="11"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Shortcut}" 
                                       Foreground="{StaticResource BrushTextTertiary}"
                                       FontSize="10" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Hint -->
            <TextBlock Grid.Row="1" 
                       Text="Press Enter to execute • Escape to close • ↑↓ to navigate"
                       Foreground="{StaticResource BrushTextTertiary}"
                       FontSize="10"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>
        </Grid>
    </Border>
</Window>
