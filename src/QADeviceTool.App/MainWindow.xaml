<Window x:Class="LogPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LogPro"
        xmlns:vm="clr-namespace:LogPro.ViewModels"
        xmlns:views="clr-namespace:LogPro.Views"
        xmlns:conv="clr-namespace:LogPro.Converters"
        Title="LogPro"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{x:Null}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Icon="Assets/LogProIcon.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="4" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="Padding" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionViewModel}">
            <views:SessionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
            <views:DeviceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppManagementViewModel}">
            <views:AppManagementView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShellViewModel}">
            <views:ShellView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeepLinkViewModel}">
            <views:DeepLinkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VitalsViewModel}">
            <views:VitalsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileExplorerViewModel}">
            <views:FileExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MacroViewModel}">
            <views:MacroView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StressTestViewModel}">
            <views:StressTestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border Background="{StaticResource BrushVoid}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="{StaticResource BrushBase}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="LogPro"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" v3.0.0"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="10"
                                   Foreground="{StaticResource BrushCyan}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>

                    <!-- Device Selector -->
                    <Border Grid.Column="1" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Devices}"
                                  SelectedItem="{Binding SelectedDevice}"
                                  DisplayMemberPath="DisplayName"
                                  Width="160" Height="24"
                                  VerticalAlignment="Center"
                                  Background="{StaticResource BrushElevated}"
                                  Foreground="{StaticResource BrushTextPrimary}"
                                  BorderBrush="{StaticResource BrushBorder}"
                                  BorderThickness="1"
                                  FontSize="11">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Border>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="&#x2014;" Click="Minimize_Click" Width="40" Height="28"
                                Style="{StaticResource WindowControlButton}" FontSize="10" />
                        <Button Content="&#x25A1;" Click="Maximize_Click" Width="40" Height="28"
                                Style="{StaticResource WindowControlButton}" FontSize="10" />
                        <Button Content="&#x2715;" Click="Close_Click" Width="40" Height="28"
                                Style="{StaticResource CloseButton}" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource BrushBase}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,8">
                            <RadioButton Style="{StaticResource NavButton}"
                                         Content="Dashboard"
                                         IsChecked="True"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Dashboard" />
                            <RadioButton Style="{StaticResource NavButton}"
                                         Content="Sessions"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Sessions" />
                            <RadioButton Style="{StaticResource NavButton}"
                                         Content="Devices"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Device" />
                            <RadioButton Style="{StaticResource NavButton}"
                                         Content="File Explorer"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Files" />
                            <RadioButton Style="{StaticResource NavButton}"
                                         Content="Macros"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Macros" />
                            <RadioButton Style="{StaticResource NavButton}"
                                         Content="Stress Test"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="StressTest" />
                            <RadioButton Style="{StaticResource NavButton}"
                                         Content="Settings"
                                         Command="{Binding NavigateCommand}"
                                         CommandParameter="Settings" />
                        </StackPanel>

                        <!-- Bottom: collapse toggle + connected count -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,4">
                            <Border Height="1" Background="{StaticResource BrushBorder}"
                                    Margin="8,4,8,8" />

                            <Button Style="{StaticResource IconButton}"
                                    Command="{Binding ToggleSidebarCommand}"
                                    HorizontalAlignment="Center"
                                    Width="32" Height="32"
                                    ToolTip="Toggle Sidebar"
                                    FontFamily="{StaticResource FontMono}"
                                    Content="&#x2630;" />

                            <Border Margin="6,6,6,4"
                                    Background="{StaticResource BrushElevated}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource BrushRed}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConnectedDeviceCount, Converter={x:Static conv:IntToBoolConverter.Instance}}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource BrushGreen}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Style="{StaticResource TextCaption}" FontSize="10" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <Binding Path="ConnectedDeviceCount" StringFormat="{}{0} device(s)" />
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- CONTENT AREA -->
                <Border Grid.Column="1" Background="{StaticResource BrushVoid}">
                    <!-- DIAG: direct view test -->
                    <ContentPresenter Content="{Binding CurrentView}" />
                </Border>
            </Grid>

            <!-- STATUS BAR -->
            <Border Grid.Row="2" Background="{StaticResource BrushBase}"
                    BorderBrush="{StaticResource BrushCyanDim}"
                    BorderThickness="0,1,0,0">
                <DockPanel Margin="12,0">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding StatusBarText}"
                               Style="{StaticResource TextCaption}"
                               VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="9"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center">
                        LogPro v3.0.0
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
