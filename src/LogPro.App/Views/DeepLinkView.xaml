<UserControl x:Class="LogPro.Views.DeepLinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels"
             xmlns:conv="clr-namespace:LogPro.Converters">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource FrostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Surface}" Opacity="0.72" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardHdr" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="12,12,0,0" />
        </Style>
        <Style x:Key="HdrText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushPrimaryLight}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushCyan}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushVoid}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCyan}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground" Value="{DynamicResource BrushRed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushRedDim}" />
        </Style>
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrushBase}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushPrimaryLight}" />
            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushPrimaryLight}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MonoBlock" TargetType="TextBox" BasedOn="{StaticResource DarkInput}">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
    </UserControl.Resources>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="24,16">
        <TextBlock Text="Deep Link" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding IsRouting, Converter={x:Static conv:InverseBoolConverter.Instance}}" HorizontalAlignment="Left" MinWidth="300" Margin="0,8">
          <ComboBox.ItemTemplate><DataTemplate><StackPanel>
            <TextBlock Text="{Binding DisplayName}"/>
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PlatformIcon}" Margin="0,0,8,0"/><TextBlock Text="{Binding MaskedSerial}" Margin="0,0,8,0"/><TextBlock Text="{Binding StatusText}"/></StackPanel>
          </StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding CapabilityMessage}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,24">
          <StackPanel IsEnabled="{Binding IsRouting, Converter={x:Static conv:InverseBoolConverter.Instance}}">
            <TextBlock Text="Target link (Enter to launch)" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,8"/>
            <TextBox Style="{StaticResource DarkInput}" Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}" KeyDown="TargetUrl_KeyDown" AutomationProperties.Name="Target deep link"/>
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4"/>
            <CheckBox Content="Reveal full link in preview" IsChecked="{Binding RevealPreview}" Margin="0,8"/>
            <TextBlock Text="{Binding LinkPreview}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,12"/>
            <TextBlock Text="Optional target package (empty uses Android resolution)" Foreground="{DynamicResource BrushTextPrimary}"/>
            <TextBox Style="{StaticResource DarkInput}" Text="{Binding TargetPackage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Target package" Margin="0,4"/>
            <ComboBox ItemsSource="{Binding InstalledPackages}" SelectedItem="{Binding SelectedInstalledPackage}" MinWidth="300" HorizontalAlignment="Left" AutomationProperties.Name="Installed packages"/>
            <TextBlock Text="{Binding OptionsMessage}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4"/><CheckBox Content="Include BROWSABLE category (browser-style launch)" IsChecked="{Binding Browsable}" Margin="0,8"/>
          </StackPanel>
          <WrapPanel Margin="0,8">
            <Button Content="Launch" Command="{Binding FireIntentCommand}" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="Inspect handlers" Command="{Binding InspectHandlersCommand}" Padding="12,8" Margin="0,0,8,0"/>
            <Button Content="Load installed apps" Command="{Binding LoadAppsCommand}" Padding="12,8" Margin="0,0,8,0"/>
            <Button Content="Clear input" Command="{Binding ClearInputCommand}" IsEnabled="{Binding IsRouting, Converter={x:Static conv:InverseBoolConverter.Instance}}" Padding="12,8" Margin="0,0,8,0"/>
            <Button Content="Stop" Command="{Binding StopCommand}" Padding="12,8"/>
          </WrapPanel>
          <ProgressBar IsIndeterminate="{Binding IsRouting}" Height="4" Margin="0,4"/>
          <TextBlock Text="{Binding StatusKind}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4"/>
          <TextBlock Text="{Binding HandlerSummary}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4"/>
          <Expander Header="Saved presets" Margin="0,12">
            <StackPanel IsEnabled="{Binding IsRouting, Converter={x:Static conv:InverseBoolConverter.Instance}}">
              <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" AutomationProperties.Name="Saved presets" Margin="0,8"/>
              <TextBox Style="{StaticResource DarkInput}" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Preset name"/>
              <WrapPanel Margin="0,8"><Button Content="Save current link" Command="{Binding SavePresetCommand}" Padding="12,6" Margin="0,0,8,0"/><Button Content="Remove selected preset" Command="{Binding RemovePresetCommand}" Padding="12,6"/></WrapPanel>
              <CheckBox Content="Persist presets locally (includes full URLs and parameters)" IsChecked="{Binding PersistPresets}" Margin="0,4"/>
              <TextBlock Text="Persistence is optional. History and exports always hide link payloads." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
          </Expander>
          <Expander Header="Batch test (one link per line, up to 50)" Margin="0,8">
            <StackPanel>
              <TextBox Style="{StaticResource DarkInput}" Text="{Binding BatchInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsRouting, Converter={x:Static conv:InverseBoolConverter.Instance}}" AutomationProperties.Name="Batch deep links"/>
              <TextBlock Text="Links run sequentially on the selected device with the current package and category options. A timeout stops the batch. Each batch has a five-minute time limit." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8"/>
              <Button Content="Run batch" Command="{Binding RunBatchCommand}" Padding="12,6" HorizontalAlignment="Left"/>
            </StackPanel>
          </Expander>
          <Expander Header="Launch history (last 100 results)" IsExpanded="True" Margin="0,8">
            <StackPanel>
              <WrapPanel Margin="0,8"><Button Content="Export sanitized results" Command="{Binding ExportHistoryCommand}" Padding="12,6" Margin="0,0,8,0"/><Button Content="Clear history" Command="{Binding ClearHistoryCommand}" Padding="12,6"/></WrapPanel>
              <ListBox ItemsSource="{Binding History}" Height="180" AutomationProperties.Name="Launch history">
                <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Result.Activity}"/><StackPanel Orientation="Horizontal"><TextBlock Text="Total / wait (ms): "/><TextBlock Text="{Binding Result.TotalTimeMs}"/><TextBlock Text=" / "/><TextBlock Text="{Binding Result.WaitTimeMs}"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
</UserControl>
