<UserControl x:Class="LogPro.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource FrostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Surface}" Opacity="0.72" />
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushPrimaryLight}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushCyan}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushVoid}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCyan}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground" Value="{DynamicResource BrushRed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushRedDim}" />
        </Style>
        <Style x:Key="DarkInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrushBase}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="{DynamicResource BrushPrimaryLight}" />
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushPrimaryLight}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BrushVoid}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Stretch" MaxWidth="1100" Margin="32,24,32,24">
                <StackPanel>
                    <!-- Page Header -->
                    <StackPanel Margin="0,0,0,24">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="LOGPRO TERMINAL" FontFamily="{StaticResource FontHeader}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryLight}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontFamily="{StaticResource FontHeader}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextMuted}" Opacity="0.7" VerticalAlignment="Center" Margin="12,4,0,0" />
                        </WrapPanel>
                        <TextBlock Text="System configuration, dependencies, and runtime preferences."
                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- TOOL DEPENDENCIES -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TOOL DEPENDENCIES" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Content="↻ Re-check" Command="{Binding CheckDependenciesCommand}" />
                            </Grid>

                            <Border Background="{DynamicResource BrushCyanGlow}" BorderBrush="{DynamicResource BrushCyanDim}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrushPrimaryLight}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushPrimaryLight}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </WrapPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding ToolStatuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Background="{DynamicResource BrushPrimaryLight}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Version}" Foreground="{DynamicResource BrushTextMuted}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource BrushTextMuted}" FontFamily="{StaticResource FontMono}" FontSize="10" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusIcon}" FontSize="16" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="If a device is missing, reconnect USB, approve debugging or trust on the device, then Re-check. Windows iOS USB also needs the Apple Mobile Device Service running." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- SESSIONS DIRECTORY -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SESSIONS DIRECTORY" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Log sessions and screenshots are written here." Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource DarkInput}" Text="{Binding SessionsDirectory}" IsReadOnly="True" />
                                <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Content="Browse" Command="{Binding BrowseSessionsFolderCommand}" Margin="8,0,0,0" />
                                <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Content="Open" Command="{Binding OpenSessionsFolderCommand}" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- LOG RETENTION -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="LOG RETENTION" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Automatically purge old logs and completed LogPro sessions, including their screenshots and recordings." Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <WrapPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding LogRetentionOptions}"
                                          SelectedItem="{Binding SelectedLogRetention}"
                                          DisplayMemberPath="Text" SelectedValuePath="Value"
                                          Width="220" />
                                <Button Style="{StaticResource PrimaryBtn}" Content="Save" Command="{Binding SaveLogRetentionCommand}" Margin="12,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- APPEARANCE -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SwitchToDarkThemeCommand}" Margin="0,0,8,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushPrimaryLight}" BorderThickness="2" CornerRadius="10" Padding="14">
                                                <StackPanel>
                                                    <Border Background="{DynamicResource BrushVoid}" CornerRadius="6" Height="56" Margin="0,0,0,10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                                        <Ellipse Width="16" Height="16" Fill="{DynamicResource BrushCyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="DARK TERMINAL" FontFamily="{StaticResource FontHeader}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryLight}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                                    <Setter TargetName="b" Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding SwitchToLightThemeCommand}" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Opacity="0.65">
                                                <StackPanel>
                                                    <Border Background="{DynamicResource BrushTextPrimary}" CornerRadius="6" Height="56" Margin="0,0,0,10" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                                        <Ellipse Width="16" Height="16" Fill="{DynamicResource BrushCyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="LIGHT INTERFACE" FontFamily="{StaticResource FontHeader}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushPrimaryLight}" />
                                                    <Setter TargetName="b" Property="BorderThickness" Value="2" />
                                                    <Setter TargetName="b" Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- WIRELESS ADB -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="WIRELESS ADB PAIRING" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Connect Android devices over Wi-Fi. Enable Wireless Debugging in Developer Options first."
                                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="IP:PORT" Style="{StaticResource MetaLabel}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource DarkInput}" Text="{Binding PairingIpPort, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="PAIRING CODE" Style="{StaticResource MetaLabel}" Margin="0,0,0,6" />
                                    <PasswordBox x:Name="PairingCodeInput" PasswordChanged="PairingCodeInput_PasswordChanged" Padding="10,7" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="Pair" Command="{Binding PairDeviceCommand}" IsEnabled="{Binding IsWirelessAvailable}" VerticalAlignment="Bottom" />
                            </Grid>

                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="CONNECTION IP:PORT (shown separately in Wireless debugging)" Style="{StaticResource MetaLabel}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource DarkInput}" Text="{Binding ConnectionIpPort, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left" />
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Style="{StaticResource GhostBtn}" Content="Discover" Command="{Binding DiscoverPortsCommand}" IsEnabled="{Binding IsWirelessAvailable}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostBtn}" Content="Connect" Command="{Binding ConnectWirelessDeviceCommand}" IsEnabled="{Binding IsWirelessAvailable}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource DangerBtn}" Content="Disconnect" Command="{Binding DisconnectWirelessDeviceCommand}" IsEnabled="{Binding IsWirelessAvailable}" />
                            </WrapPanel>

                            <Border Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                <StackPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="DISCOVERED " Style="{StaticResource MetaLabel}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DiscoveredPorts}" Foreground="{DynamicResource BrushPrimaryLight}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="STATUS " Style="{StaticResource MetaLabel}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding WirelessStatus}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- DATA MANAGEMENT -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DATA MANAGEMENT" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="Clear settings, app logs and completed LogPro sessions after reviewing the exact scope. Other files in a custom Sessions folder are kept."
                                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,12" />
                            <Button Style="{StaticResource DangerBtn}" Content="Clear All Data" Command="{Binding ClearAllDataCommand}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding ClearDataStatus}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding StorageSummary}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,8,0,0" />
                            <ListBox ItemsSource="{Binding CleanupTargets}" Height="90" Margin="0,6,0,0" FontSize="10" />
                            <Button Style="{StaticResource GhostBtn}" Content="Refresh Storage Inventory" Command="{Binding RefreshStorageInventoryCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <Button Style="{StaticResource GhostBtn}" Content="Export My Data" Command="{Binding ExportMyDataCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <Button Style="{StaticResource GhostBtn}" Content="Open Logs Folder" Command="{Binding OpenLogsFolderCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock Text="View diagnostic log files in Explorer." Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- UPDATES -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="UPDATES" Style="{StaticResource SectionLabel}" />
                            <CheckBox Content="Check and download compatible updates automatically" IsChecked="{Binding CheckForUpdatesOnStartup}" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8" />
                            <WrapPanel Margin="0,4,0,8"><TextBlock Text="Check interval (hours): " Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/><TextBox Text="{Binding UpdateIntervalHours, UpdateSourceTrigger=LostFocus}" Width="60" AutomationProperties.Name="Update check interval in hours"/></WrapPanel>
                            <TextBlock Text="Downloads are verified. Installation waits for idle devices and may require Windows administrator approval." TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource GhostBtn}" Content="Check Now" Command="{Binding CheckForUpdatesCommand}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,8,0,8" />
                            <TextBlock Text="{Binding UpdateCheckDetails}" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ListBox ItemsSource="{Binding AvailableUpdates}" SelectedItem="{Binding SelectedUpdate}" DisplayMemberPath="ToolName" Height="90" />
                            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryBtn}" Content="Install Selected" Command="{Binding ApplyUpdateCommand}" CommandParameter="{Binding SelectedUpdate}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostBtn}" Content="Skip Selected Version" Command="{Binding SkipUpdateCommand}" CommandParameter="{Binding SelectedUpdate}" />
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource GhostBtn}" Content="Rollback ADB" Command="{Binding RollbackToolCommand}" CommandParameter="adb" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostBtn}" Content="Rollback scrcpy" Command="{Binding RollbackToolCommand}" CommandParameter="scrcpy" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostBtn}" Content="Rollback iOS tool" Command="{Binding RollbackToolCommand}" CommandParameter="pymobiledevice3" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ABOUT -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" />

                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="LogPro" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{StaticResource FontHeader}" FontSize="20" FontWeight="Bold" />
                                <Border Background="{DynamicResource BrushCyanGlow}" BorderBrush="{DynamicResource BrushCyanDim}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="12,4,0,0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushPrimaryLight}">
                                        <Run Text="v" /><Run Text="{Binding AppVersion}" />
                                    </TextBlock>
                                </Border>
                            </WrapPanel>

                            <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,18">
                                Windows LogPro utility for manual game testers. Supports Android &amp; iOS device log capture, session management, screen mirroring, and device snapshots.
                            </TextBlock>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="DEVELOPER" Style="{StaticResource MetaLabel}" Margin="0,0,0,6" />
                                        <TextBlock Text="Sundar Lohar" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="REACH OUT" Style="{StaticResource MetaLabel}" Margin="0,0,0,6" />
                                        <TextBlock FontSize="12" Cursor="Hand">
                                            <Hyperlink NavigateUri="https://github.com/sundarlohar007" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource BrushPrimaryLight}" TextDecorations="None">
                                                github.com/sundarlohar007
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="sundar.lohar@ubisoft.com" Foreground="{DynamicResource BrushPrimaryLight}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Background="{DynamicResource BrushBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="THIRD-PARTY SOFTWARE" Style="{StaticResource MetaLabel}" Margin="0,0,0,10" />
                                    <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="18">
                                        Bundled open-source components (full text in 'licenses' folder):
                                    </TextBlock>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="scrcpy" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="Apache License 2.0" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="pymobiledevice3" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="GNU GPL v3" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <TextBlock Text="Powered by " Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="AntiGravity" Foreground="{DynamicResource BrushPrimaryLight}" FontFamily="{StaticResource FontHeader}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
