<UserControl x:Class="LogPro.Views.VitalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels"
             xmlns:conv="clr-namespace:LogPro.Converters">
    <UserControl.Resources>
        <conv:PercentToArcConverter x:Key="PercentToArc" />

        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource FrostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <DrawingBrush TileMode="Tile" Stretch="None"
                                  Viewport="0,0,4,4" ViewportUnits="Absolute"
                                  Viewbox="0,0,4,4" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <!-- Base tinted glass -->
                                <GeometryDrawing>
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,4,4" />
                                    </GeometryDrawing.Geometry>
                                    <GeometryDrawing.Brush>
                                        <SolidColorBrush Color="{DynamicResource Surface}" Opacity="0.72" />
                                    </GeometryDrawing.Brush>
                                </GeometryDrawing>
                                <!-- Noise grain (frosted texture) -->
                                <GeometryDrawing Brush="#05FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,1" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#04000000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="2,1,1,1" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#06FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="1,3,1,1" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#03000000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="3,2,1,1" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GaugeLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>
        <Style x:Key="GaugeValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="GaugeSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
        </Style>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryLight}" />
            <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BrushVoid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="24,24,24,16" Style="{StaticResource GlassPanel}" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Vitals" FontFamily="{StaticResource FontHeader}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryLight}" VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{DynamicResource BrushBorder}" Margin="16,0" />
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" Width="220" />
                </WrapPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderBtn}" Command="{Binding RecordCommand}" IsEnabled="{Binding IsPollingSupported}">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="RECORD / PAUSE" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderBtn}" Command="{Binding ExportCsvCommand}" Margin="8,0,0,0">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="EXPORT CSV" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Button>
                    <Button Style="{StaticResource HeaderBtn}" Command="{Binding ClearRecordedSamplesCommand}" Margin="8,0,0,0" Content="CLEAR SAMPLES" />
                    <Button Style="{StaticResource HeaderBtn}" Command="{Binding TogglePollingCommand}" IsEnabled="{Binding IsPollingSupported}" Margin="8,0,0,0" Foreground="{DynamicResource BrushTextSecondary}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE72C;" />
                                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPolling}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="1" Margin="24,0,24,12">
            <TextBlock Text="{Binding CapabilityMessage}" Foreground="{DynamicResource BrushAmberBright}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding LastSampleText}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding IsRecording, StringFormat='Recording: {0}'}" Foreground="{DynamicResource BrushAmberBright}" Margin="0,0,12,0" />
            <TextBlock Text="Interval (s):" Foreground="{DynamicResource BrushTextSecondary}" />
            <ComboBox ItemsSource="{Binding PollIntervals}" SelectedItem="{Binding PollIntervalSeconds}" Width="55" Margin="6,0,12,0" />
            <TextBlock Text="Target package:" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBox Text="{Binding TargetPackage, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="6,0,12,0" />
            <TextBlock Text="CPU alert %:" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBox Text="{Binding CpuAlertThreshold}" Width="35" Margin="6,0,8,0" />
            <TextBlock Text="Memory alert %:" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBox Text="{Binding MemoryAlertThreshold}" Width="35" Margin="6,0,8,0" />
            <TextBlock Text="Battery alert %:" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBox Text="{Binding BatteryAlertThreshold}" Width="35" Margin="6,0,8,0" />
            <CheckBox Content="Include device ID + SSID/IP in CSV" IsChecked="{Binding IncludeIdentifiersInExport}" Foreground="{DynamicResource BrushTextSecondary}" />
        </WrapPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <UniformGrid Columns="3" Rows="2" Margin="24,0,24,16">
            <UniformGrid.Resources>
                <Style TargetType="Border" BasedOn="{StaticResource GlassPanel}">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="Padding" Value="16" />
                    <Setter Property="MinHeight" Value="190" />
                </Style>
            </UniformGrid.Resources>

            <!-- CPU -->
            <Border>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CPU USAGE" Style="{StaticResource GaugeLabel}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource GaugeSubtitle}">
                        <Run Text="TREND: " /><Run Text="{Binding CpuTrend}" />
                    </TextBlock>
                    <Grid Margin="0,8">
                        <Canvas Width="120" Height="120" HorizontalAlignment="Center">
                            <Ellipse Canvas.Left="6" Canvas.Top="6" Width="108" Height="108" Stroke="#15FFFFFF" StrokeThickness="8" />
                            <Path Stroke="{DynamicResource BrushCyan}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding CpuPercent, Converter={StaticResource PercentToArc}}" />
                        </Canvas>
                        <TextBlock Style="{StaticResource GaugeValue}" Foreground="{DynamicResource BrushPrimaryLight}">
                            <Run Text="{Binding CpuDisplay}" />
                        </TextBlock>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding TargetAppDetail}" Style="{StaticResource GaugeSubtitle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CpuStatus}" Style="{StaticResource GaugeSubtitle}" />
                </DockPanel>
            </Border>

            <!-- Memory -->
            <Border>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MEMORY USAGE" Style="{StaticResource GaugeLabel}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding MemoryDetail}" Style="{StaticResource GaugeSubtitle}" />
                    <Grid Margin="0,8">
                        <Canvas Width="120" Height="120" HorizontalAlignment="Center">
                            <Ellipse Canvas.Left="6" Canvas.Top="6" Width="108" Height="108" Stroke="#15FFFFFF" StrokeThickness="8" />
                            <Path Stroke="{DynamicResource BrushAmberBright}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding MemoryPercent, Converter={StaticResource PercentToArc}}" />
                        </Canvas>
                        <TextBlock Style="{StaticResource GaugeValue}" Foreground="{DynamicResource BrushAmberBright}">
                            <Run Text="{Binding MemoryDisplay}" />
                        </TextBlock>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding MemoryTrend}" Style="{StaticResource GaugeSubtitle}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding MemoryStatus}" Style="{StaticResource GaugeSubtitle}" />
                </DockPanel>
            </Border>

            <!-- Temperature -->
            <Border>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TEMPERATURE" Style="{StaticResource GaugeLabel}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ThermalStatus}" Style="{StaticResource GaugeSubtitle}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding TemperatureStatus}" Style="{StaticResource GaugeSubtitle}" />
                    <Grid Margin="0,8">
                        <Canvas Width="120" Height="120" HorizontalAlignment="Center">
                            <Ellipse Canvas.Left="6" Canvas.Top="6" Width="108" Height="108" Stroke="#15FFFFFF" StrokeThickness="8" />
                            <Path Stroke="{DynamicResource BrushPrimaryLight}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding TemperatureCelsius, Converter={StaticResource PercentToArc}, ConverterParameter=54}" />
                        </Canvas>
                        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource BrushPrimaryLight}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Style="{StaticResource GaugeValue}" Foreground="{DynamicResource BrushPrimaryLight}">
                                <Run Text="{Binding TemperatureDisplay}" />
                            </TextBlock>
                        </WrapPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Battery -->
            <Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="BATTERY LEVEL" Style="{StaticResource GaugeLabel}" />
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,12">
                        <TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="{DynamicResource BrushPrimaryLight}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Foreground="{DynamicResource BrushPrimaryLight}" FontFamily="{StaticResource FontHeader}" FontSize="40" FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="{Binding BatteryDisplay}" />
                        </TextBlock>
                    </WrapPanel>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding BatteryDetail}" Style="{StaticResource GaugeSubtitle}" />
                        <TextBlock Text="{Binding BatteryStatusText}" Style="{StaticResource GaugeSubtitle}" />
                        <Border Height="6" Background="{DynamicResource BrushOverlay}" CornerRadius="3" Margin="0,6,0,0">
                            <Border Background="{DynamicResource BrushCyan}" CornerRadius="3" HorizontalAlignment="Left" Width="{Binding BatteryPercent}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Network -->
            <Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="NETWORK INFO" Style="{StaticResource GaugeLabel}" />
                    <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12">
                        <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{DynamicResource BrushPrimaryLight}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding NetworkSsid}" FontFamily="{StaticResource FontHeader}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                            <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}">
                                <Run Text="IP: " /><Run Text="{Binding NetworkIp}" />
                            </TextBlock>
                        </StackPanel>
                    </WrapPanel>
                    <WrapPanel Grid.Row="2" Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushCyan}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding NetworkLatency}" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{DynamicResource BrushPrimaryLight}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Disk I/O capability -->
            <Border>
                <StackPanel>
                    <TextBlock Text="DISK I/O" Style="{StaticResource GaugeLabel}" />
                    <TextBlock Text="{Binding DiskStatus}" Style="{StaticResource GaugeSubtitle}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="24,0,24,24" Style="{StaticResource GlassPanel}" Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xEA37;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="VITALS LOG" FontFamily="{StaticResource FontHeader}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Grid.Column="1" Text="Recent samples and alerts" Style="{StaticResource GaugeSubtitle}" />
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BrushBorder}" Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding VitalsLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}">
                                        <Run Text="[" /><Run Text="{Binding Timestamp}" /><Run Text="]" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="{StaticResource FontHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimaryLight}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
