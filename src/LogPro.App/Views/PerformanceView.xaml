<UserControl x:Class="LogPro.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels;assembly=LogPro.ViewModels"
             xmlns:conv="clr-namespace:LogPro.Converters"
             Background="{DynamicResource BrushVoid}">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{DynamicResource FrostBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource Surface}" Opacity="0.72" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BrushPrimaryLight}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushCyan}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushVoid}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCyan}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Foreground" Value="{DynamicResource BrushRed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushRedDim}" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="24,24,24,16">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Performance" FontFamily="{StaticResource FontHeader}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryBtn}" Content="Start" Command="{Binding StartProfilingCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource DangerBtn}" Content="Stop" Command="{Binding StopProfilingCommand}" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="24,0,24,16" Padding="12">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Device" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" />
                    <ComboBox Width="170" ItemsSource="{Binding AvailableDevices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" IsEnabled="{Binding IsProfiling, Converter={x:Static conv:InverseBoolConverter.Instance}}" Margin="0,0,12,0" />
                    <TextBlock Text="App package" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" />
                    <ComboBox Width="240" ItemsSource="{Binding AvailablePackages}" Text="{Binding TargetPackage, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,8,0" />
                    <Button Content="Load apps" Command="{Binding RefreshPackagesCommand}" Style="{StaticResource GhostBtn}" Margin="0,0,12,0" />
                    <TextBlock Text="Interval ms" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,6,0" />
                    <TextBox Width="65" Text="{Binding SampleIntervalMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,12,0" />
                    <Button Content="Mark event" Command="{Binding AddMarkerCommand}" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" />
                    <Button Content="Export JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource GhostBtn}" Margin="0,0,8,0" />
                    <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource GhostBtn}" />
                </WrapPanel>
                <TextBlock Text="{Binding ActiveTarget}" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding MetricAvailability}" Foreground="{DynamicResource BrushTextSecondary}" />
                <TextBlock Text="{Binding ThermalAlert}" Foreground="{DynamicResource BrushRed}" />
                <WrapPanel Margin="0,6,0,0"><TextBlock Text="Min avg FPS" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/><TextBox Width="55" Text="{Binding MinimumAverageFps}" Margin="6,0,16,0"/><TextBlock Text="Max memory growth MB" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/><TextBox Width="55" Text="{Binding MaximumMemoryGrowthMb}" Margin="6,0,16,0"/><TextBlock Text="Max FPS regression %" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/><TextBox Width="55" Text="{Binding AllowedFpsRegressionPercent}" Margin="6,0"/></WrapPanel>
                <TextBlock Text="{Binding PerformanceAlerts}" Foreground="{DynamicResource BrushRed}" />
                <TextBlock Text="{Binding MemoryTrend}" Foreground="{DynamicResource BrushTextSecondary}" />
                <TextBlock Text="{Binding SampleOverhead}" Foreground="{DynamicResource BrushTextMuted}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="24,0,24,24" Padding="12" MaxHeight="430">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="Run timeline · presentation gaps over two refresh periods are estimates, not Android jank classifications" Foreground="{DynamicResource BrushTextSecondary}" />
                <TextBlock Text="{Binding SessionVerdict}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" />
                <TextBlock Text="{Binding BaselineComparison}" Foreground="{DynamicResource BrushTextSecondary}" />
                <WrapPanel><Button Content="Pin this run as baseline" Command="{Binding PinBaselineCommand}" Style="{StaticResource GhostBtn}" Margin="0,0,8,0"/><Button Content="Clear baseline" Command="{Binding ClearBaselineCommand}" Style="{StaticResource GhostBtn}" /></WrapPanel>
                <TextBlock Text="FPS trend (auto-scaled)" Foreground="{DynamicResource BrushTextSecondary}" />
                <TextBlock Text="{Binding FpsChartRange}" Foreground="{DynamicResource BrushTextMuted}" />
                <Polyline Points="{Binding ChartSamples, Converter={x:Static conv:ProfilerSparklineConverter.Instance}, ConverterParameter=fps}" Stroke="{DynamicResource BrushCyan}" StrokeThickness="2" HorizontalAlignment="Stretch" Height="70" Stretch="Uniform" />
                <TextBlock Text="CPU % trend (auto-scaled)" Foreground="{DynamicResource BrushTextSecondary}" />
                <TextBlock Text="{Binding CpuChartRange}" Foreground="{DynamicResource BrushTextMuted}" />
                <Polyline Points="{Binding ChartSamples, Converter={x:Static conv:ProfilerSparklineConverter.Instance}, ConverterParameter=cpu}" Stroke="{DynamicResource BrushRed}" StrokeThickness="2" HorizontalAlignment="Stretch" Height="55" Stretch="Uniform" />
                <TextBlock Text="Memory MB trend (auto-scaled)" Foreground="{DynamicResource BrushTextSecondary}" />
                <TextBlock Text="{Binding MemoryChartRange}" Foreground="{DynamicResource BrushTextMuted}" />
                <Polyline Points="{Binding ChartSamples, Converter={x:Static conv:ProfilerSparklineConverter.Instance}, ConverterParameter=mem}" Stroke="{DynamicResource BrushPrimaryLight}" StrokeThickness="2" HorizontalAlignment="Stretch" Height="55" Stretch="Uniform" />
                <ItemsControl ItemsSource="{Binding Markers}" MaxHeight="55"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{DynamicResource BrushTextMuted}"><Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"/><Run Text=" — "/><Run Text="{Binding Label}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="160" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time UTC" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" />
                        <DataGridTextColumn Header="FPS" Binding="{Binding Fps, StringFormat={}{0:F1}}" />
                        <DataGridTextColumn Header="p90 ms" Binding="{Binding FrameTimeP90Ms, StringFormat={}{0:F1}}" />
                        <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:F1}}" />
                        <DataGridTextColumn Header="PSS KB" Binding="{Binding PssKb}" />
                        <DataGridTextColumn Header="Thermal" Binding="{Binding ThermalStatus}" />
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,8,0,0"><TextBlock Text="Tier duration s" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/><TextBox Width="45" Text="{Binding ComparisonSeconds}" Margin="8,0"/><Button Content="Compare online Android devices" Command="{Binding CompareDevicesCommand}" Style="{StaticResource GhostBtn}" /><Button Content="Cancel" Command="{Binding CancelComparisonCommand}" Style="{StaticResource GhostBtn}" Margin="8,0,0,0" /></WrapPanel>
                <ItemsControl ItemsSource="{Binding TierResults}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="{DynamicResource BrushTextSecondary}"><Run Text="{Binding Profile.Label}"/><Run Text=" · avg FPS "/><Run Text="{Binding AvgFps}"/><Run Text=" · data sufficient "/><Run Text="{Binding HasSufficientData}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <ItemsControl ItemsSource="{Binding RecentRuns}" MaxHeight="55" />
            </StackPanel></ScrollViewer>
        </Border>

        <Grid Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="FPS" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" />
                    <TextBlock Text="{Binding Fps, StringFormat={}{0:F1}}" Foreground="{DynamicResource BrushPrimaryLight}" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="{Binding FrameP90Ms, StringFormat=p90 {0:F1} ms}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="CPU" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" />
                    <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:F0}%}" Foreground="{DynamicResource BrushPrimaryLight}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="MEMORY (PSS)" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" />
                    <TextBlock Text="{Binding PssKb, StringFormat={}{0} KB}" Foreground="{DynamicResource BrushPrimaryLight}" FontSize="28" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="EST. FRAME GAPS" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" />
                    <TextBlock Text="{Binding JankDisplay}" Foreground="{DynamicResource BrushRed}" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="{Binding BatteryLevel, StringFormat=battery {0}%}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
