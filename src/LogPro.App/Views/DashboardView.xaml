<UserControl x:Class="LogPro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogPro.ViewModels"
             xmlns:conv="clr-namespace:LogPro.Converters">

    <Grid Background="{DynamicResource BrushVoid}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="StatCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrostBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Surface}" Opacity="0.72" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StatLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
            </Style>
            <Style x:Key="StatValue" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>
            <Style x:Key="StatSubtitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
            </Style>
            <Style x:Key="GlassCardLg" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BorderBrush" Value="{DynamicResource FrostBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Surface}" Opacity="0.72" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CardHeader" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushSurface}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="CornerRadius" Value="12,12,0,0" />
            </Style>
            <Style x:Key="CardHeaderText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            </Style>
            <Style x:Key="DeviceRow" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="DeviceIconBox" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushOverlay}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
            </Style>
            <Style x:Key="QuickActionBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2A2A2A" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrushPrimaryLight}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Dashboard" FontFamily="{StaticResource FontHeader}" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushTextPrimary}" />
                <TextBlock Text="{Binding SelectedDevice.DisplayName, StringFormat=Selected device: {0}}"
                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" />
                <TextBlock Text="{Binding WelcomeMessage}" Foreground="{DynamicResource BrushTextSecondary}"
                           FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DiscoveryMessage}" Foreground="{DynamicResource BrushRed}"
                           FontSize="12" TextWrapping="Wrap" Visibility="{Binding HasDiscoveryError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding PlatformNotice}" Foreground="{DynamicResource BrushTextSecondary}"
                           FontSize="12" TextWrapping="Wrap" Visibility="{Binding HasPlatformNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="40" Height="40" Margin="0,0,12,0"
                        Background="{DynamicResource BrushSurface}" Foreground="{DynamicResource BrushTextSecondary}"
                        BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}"
                        Command="{Binding RefreshDevicesCommand}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Background="{DynamicResource BrushCyan}" Foreground="{DynamicResource BrushVoid}"
                        FontFamily="{StaticResource FontHeader}" FontSize="13" FontWeight="Bold"
                        Padding="16,10" Cursor="Hand" BorderThickness="0"
                        Command="{Binding QuickStartSessionCommand}" IsEnabled="{Binding CanUseSelectedDevice}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <WrapPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="New Session" VerticalAlignment="Center" />
                                </WrapPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Connected Devices" Style="{StaticResource StatLabel}" />
                        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource BrushRed}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnlineDeviceCount, Converter={x:Static conv:IntToBoolConverter.Instance}}" Value="True">
                                            <Setter Property="Fill" Value="#4ADE80" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding OnlineDeviceCount, FallbackValue=0}" Style="{StaticResource StatValue}" Foreground="{DynamicResource BrushCyan}">
                        <TextBlock.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.4" Color="{DynamicResource Cyan}" /></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding DeviceCountSubtitle}" Style="{StaticResource StatSubtitle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Active Sessions" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding ActiveSessionCount, FallbackValue=0}" Style="{StaticResource StatValue}" Foreground="{DynamicResource BrushCyan}">
                        <TextBlock.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.4" Color="{DynamicResource Cyan}" /></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Currently running" Style="{StaticResource StatSubtitle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Tool Health" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{Binding ToolHealthColor}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding ToolHealthSummary}" Style="{StaticResource StatValue}" FontSize="22" Foreground="{Binding ToolHealthColor}" />
                    <TextBlock Text="ADB, scrcpy, iOS &amp; drivers" Style="{StaticResource StatSubtitle}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="Needs Attention" Style="{StaticResource StatLabel}" />
                    <TextBlock Text="{Binding DevicesNeedingAttentionCount}" Style="{StaticResource StatValue}" Foreground="#FBBF24" />
                    <TextBlock Text="Offline or authorization needed" Style="{StaticResource StatSubtitle}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Style="{DynamicResource FrostedGlass}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrushPrimaryLight}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="DETECTED DEVICES" Style="{StaticResource CardHeaderText}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                        <StackPanel>
                            <TextBlock Text="No devices connected. Connect a device via USB."
                                       FontFamily="{StaticResource FontHeader}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"
                                       HorizontalAlignment="Center" Margin="0,24,0,24">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DeviceRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Style="{StaticResource DeviceIconBox}" Margin="0,0,12,0">
                                                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource FontBody}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}">
                                                        <Run Text="SN: " /><Run Text="{Binding Serial, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding OsVersion}" FontFamily="{StaticResource FontHeader}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushPrimaryLight}" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                                    </StackPanel>
                                                    <Ellipse Width="8" Height="8">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushRed}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Online">
                                                                        <Setter Property="Fill" Value="#4ADE80" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Unauthorized">
                                                                        <Setter Property="Fill" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="PendingTrust">
                                                                        <Setter Property="Fill" Value="#F59E0B" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </ContentControl>
            <ContentControl Grid.Column="2" Style="{DynamicResource FrostedGlass}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardHeader}">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource BrushPrimaryLight}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource CardHeaderText}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                        <StackPanel>
                            <TextBlock Text="No activity yet. Connect a device or start a session."
                                       FontSize="12" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecentActivity}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding RecentActivity}" />
                            <TextBlock Text="TOOL HEALTH" Style="{StaticResource CardHeaderText}" Margin="0,20,0,8" />
                            <TextBlock Text="Checking tools…" Foreground="{DynamicResource BrushTextMuted}"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding ToolCheckError}" Foreground="{DynamicResource BrushRed}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding ToolStatuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </ContentControl>
        </Grid>

        <ContentControl Grid.Row="3" Margin="24,0,24,24" Style="{DynamicResource FrostedGlass}">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8">
                <Button Style="{StaticResource QuickActionBtn}" Command="{Binding QuickMirrorCommand}" IsEnabled="{Binding CanMirrorSelectedDevice}">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding MirrorActionText}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
                <Border Width="1" Height="24" Background="{DynamicResource BrushBorder}" Margin="8,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource QuickActionBtn}" Command="{Binding QuickSnapshotCommand}" IsEnabled="{Binding CanUseSelectedDevice}">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Snapshot" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
                <Border Width="1" Height="24" Background="{DynamicResource BrushBorder}" Margin="8,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource QuickActionBtn}" Command="{Binding QuickStartSessionCommand}" IsEnabled="{Binding CanUseSelectedDevice}">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Start Session" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
                <Border Width="1" Height="24" Background="{DynamicResource BrushBorder}" Margin="8,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource QuickActionBtn}" Command="{Binding RefreshDevicesCommand}">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </WrapPanel>
                </Button>
            </WrapPanel>
        </ContentControl>
    </Grid>
</UserControl>
