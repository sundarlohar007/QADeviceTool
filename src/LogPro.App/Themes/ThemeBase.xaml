<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  THEME BASE — Theme-invariant resources                 -->
    <!--  Shared by DarkTheme.xaml and LightTheme.xaml           -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Font Sizes (identical across themes) -->
    <sys:Double x:Key="FontSize9">9</sys:Double>
    <sys:Double x:Key="FontSize10">10</sys:Double>
    <sys:Double x:Key="FontSize11">11</sys:Double>
    <sys:Double x:Key="FontSize12">12</sys:Double>
    <sys:Double x:Key="FontSize13">13</sys:Double>
    <sys:Double x:Key="FontSize14">14</sys:Double>
    <sys:Double x:Key="FontSize16">16</sys:Double>
    <sys:Double x:Key="FontSize18">18</sys:Double>
    <sys:Double x:Key="FontSize20">20</sys:Double>
    <sys:Double x:Key="FontSize24">24</sys:Double>

    <!-- Monospace font (same in both themes) -->
    <FontFamily x:Key="FontMono">Cascadia Code, JetBrains Mono, Consolas, monospace</FontFamily>

    <!-- Log Level Colors (semantic — same hues in both themes) -->
    <Color x:Key="LogFatal">#EF4444</Color>
    <Color x:Key="LogError">#DC2626</Color>
    <Color x:Key="LogWarning">#F59E0B</Color>
    <Color x:Key="LogInfo">#6B7280</Color>
    <Color x:Key="LogDebug">#8A9BB5</Color>
    <Color x:Key="LogVerbose">#4B5563</Color>
    <Color x:Key="LogUnknown">#8B5CF6</Color>

    <!-- Log Level Brushes (use ThemeBase colors) -->
    <SolidColorBrush x:Key="BrushLogFatal" Color="{StaticResource LogFatal}" />
    <SolidColorBrush x:Key="BrushLogError" Color="{StaticResource LogError}" />
    <SolidColorBrush x:Key="BrushLogWarning" Color="{StaticResource LogWarning}" />
    <SolidColorBrush x:Key="BrushLogInfo" Color="{StaticResource LogInfo}" />
    <SolidColorBrush x:Key="BrushLogDebug" Color="{StaticResource LogDebug}" />
    <SolidColorBrush x:Key="BrushLogVerbose" Color="{StaticResource LogVerbose}" />
    <SolidColorBrush x:Key="BrushLogUnknown" Color="{StaticResource LogUnknown}" />
    <SolidColorBrush x:Key="BrushLogSystemDown" Color="#7F1D1D" />

</ResourceDictionary>
