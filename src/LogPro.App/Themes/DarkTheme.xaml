<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ThemeBase.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  NEO-INDUSTRIAL TERMINAL — Colors                        -->
    <!--  Void blacks · Cyan signals · Amber accents · Sharp     -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Background Hierarchy -->
    <Color x:Key="Void">#0E0E0E</Color>
    <Color x:Key="Base">#131313</Color>
    <Color x:Key="Surface">#CC151B24</Color>
    <Color x:Key="Elevated">#CC2A2A2A</Color>
    <Color x:Key="Overlay">#CC353534</Color>
    <Color x:Key="Border">#3C494C</Color>
    <Color x:Key="BorderEmphasis">#859397</Color>

    <!-- Signal Accents -->
    <Color x:Key="Cyan">#00D4F0</Color>
    <Color x:Key="CyanDim">#006B80</Color>
    <Color x:Key="CyanGlow">#003848</Color>
    <Color x:Key="Amber">#FFD6A7</Color>
    <Color x:Key="AmberBright">#FFB148</Color>
    <Color x:Key="AmberDim">#7A4F06</Color>
    <Color x:Key="Green">#10B981</Color>
    <Color x:Key="GreenDim">#065C40</Color>
    <Color x:Key="Red">#FFB4AB</Color>
    <Color x:Key="RedDim">#7F1D1D</Color>
    <Color x:Key="Violet">#8B5CF6</Color>

    <!-- Semantic Accent Keys (primary) -->
    <Color x:Key="AccentPrimary">#00D4F0</Color>
    <Color x:Key="AccentDim">#006B80</Color>
    <Color x:Key="AccentGlow">#003848</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#E5E2E1</Color>
    <Color x:Key="TextSecondary">#BAC9CD</Color>
    <Color x:Key="TextMuted">#859397</Color>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  BRUSHES                                                -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="BrushVoid" Color="{StaticResource Void}" />
    <SolidColorBrush x:Key="BrushBase" Color="{StaticResource Base}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="BrushElevated" Color="{StaticResource Elevated}" />
    <SolidColorBrush x:Key="BrushOverlay" Color="{StaticResource Overlay}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BrushBorderEmphasis" Color="{StaticResource BorderEmphasis}" />

    <SolidColorBrush x:Key="BrushCyan" Color="{StaticResource Cyan}" />
    <SolidColorBrush x:Key="BrushCyanDim" Color="{StaticResource CyanDim}" />
    <SolidColorBrush x:Key="BrushCyanGlow" Color="{StaticResource CyanGlow}" />
    <SolidColorBrush x:Key="BrushAmber" Color="{StaticResource Amber}" />
    <SolidColorBrush x:Key="BrushAmberBright" Color="{StaticResource AmberBright}" />
    <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource Green}" />
    <SolidColorBrush x:Key="BrushRed" Color="{StaticResource Red}" />
    <SolidColorBrush x:Key="BrushViolet" Color="{StaticResource Violet}" />

    <!-- Semantic Accent Brushes -->
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource AccentPrimary}" />
    <Color x:Key="PrimaryLight">#8CEBFF</Color>
    <SolidColorBrush x:Key="BrushPrimaryLight" Color="{StaticResource PrimaryLight}" />
    <SolidColorBrush x:Key="BrushAccentDim" Color="{StaticResource AccentDim}" />
    <SolidColorBrush x:Key="BrushAccentGlow" Color="{StaticResource AccentGlow}" />

    <SolidColorBrush x:Key="BrushRedDim" Color="{StaticResource RedDim}" />
    <SolidColorBrush x:Key="BrushLogSystemDown" Color="{StaticResource RedDim}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource TextMuted}" /><!-- Compatibility Aliases (keep old keys working) -->
    <SolidColorBrush x:Key="BrushBackgroundPrimary" Color="{StaticResource Base}" />
    <SolidColorBrush x:Key="BrushBackgroundSurface" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="BrushBackgroundTertiary" Color="{StaticResource Elevated}" />
    <SolidColorBrush x:Key="BrushBackgroundElevated" Color="{StaticResource Overlay}" />
    <SolidColorBrush x:Key="BrushSeparator" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BrushSeparatorOpaque" Color="{StaticResource BorderEmphasis}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource Cyan}" />
    <SolidColorBrush x:Key="BrushAccentDark" Color="{StaticResource CyanDim}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource Green}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource Red}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource Amber}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource Cyan}" />
    <SolidColorBrush x:Key="BrushBackgroundDarkest" Color="{StaticResource Void}" />
    <SolidColorBrush x:Key="BrushBackgroundDark" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="BrushBackgroundMedium" Color="{StaticResource Elevated}" />
    <SolidColorBrush x:Key="BrushBackgroundCard" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="BrushBackgroundHover" Color="{StaticResource Elevated}" />
    <SolidColorBrush x:Key="BrushBorderMuted" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BrushBorderFocus" Color="{StaticResource Cyan}" />
    <SolidColorBrush x:Key="BrushBackgroundOverlay" Color="{StaticResource Base}" Opacity="0.91" />
    <SolidColorBrush x:Key="BrushTextTertiary" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource Red}" />
    <SolidColorBrush x:Key="BrushFillPrimary" Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="BrushFillSecondary" Color="{StaticResource TextMuted}" />
    <SolidColorBrush x:Key="BrushFillTertiary" Color="{StaticResource Elevated}" />
    <SolidColorBrush x:Key="BrushFillQuaternary" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="BrushSuccessDark" Color="{StaticResource GreenDim}" />
    <SolidColorBrush x:Key="BrushDangerDark" Color="{StaticResource RedDim}" />
    <SolidColorBrush x:Key="BrushWarningDark" Color="{StaticResource AmberDim}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource Violet}" />
    <SolidColorBrush x:Key="BrushInfoDark" Color="{StaticResource Violet}" Opacity="0.65" />
    <SolidColorBrush x:Key="BrushCyanDark" Color="{StaticResource CyanDim}" />
    <SolidColorBrush x:Key="BrushPink" Color="{StaticResource Violet}" />
    <SolidColorBrush x:Key="BrushYellow" Color="{StaticResource Amber}" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  TYPOGRAPHY                                             -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Font Families (bundled with app) -->
    <FontFamily x:Key="FontHeader">pack://application:,,,/Assets/Fonts/#Space Grotesk</FontFamily>
    <FontFamily x:Key="FontBody">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="FontPrimary">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>

    <!-- Theme Dimensions -->
    <sys:Double x:Key="CornerRadiusCard">8</sys:Double>
    <sys:Double x:Key="CornerRadiusButton">8</sys:Double>
    <sys:Double x:Key="CornerRadiusInput">6</sys:Double>
    <CornerRadius x:Key="CornerRadiusCardValue">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusButtonValue">8</CornerRadius>
    <CornerRadius x:Key="CornerRadiusInputValue">6</CornerRadius>

    <Thickness x:Key="CardBorderThickness">0</Thickness>
    <x:Null x:Key="CardShadowEffect" />
<sys:Double x:Key="FontSize9">9</sys:Double>
    <sys:Double x:Key="FontSize10">10</sys:Double>
    <sys:Double x:Key="FontSize11">11</sys:Double>
    <sys:Double x:Key="FontSize12">12</sys:Double>
    <sys:Double x:Key="FontSize13">13</sys:Double>
    <sys:Double x:Key="FontSize14">14</sys:Double>
    <sys:Double x:Key="FontSize16">16</sys:Double>
    <sys:Double x:Key="FontSize18">18</sys:Double>
    <sys:Double x:Key="FontSize20">20</sys:Double>
    <sys:Double x:Key="FontSize24">24</sys:Double>

    <!-- Text Styles -->
    <Style x:Key="TextHeading1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="TextHeading2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="TextHeading3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>

    <Style x:Key="TextBodyPrimary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
    </Style>

    <Style x:Key="TextMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  BUTTONS — Industrial Sharp                              -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Primary — Cyan -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushCyan}" />
        <Setter Property="Foreground" Value="{StaticResource BrushVoid}" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding Background}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushElevated}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary — Outlined -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushCyan}" />
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanGlow}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanDim}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tertiary — Ghost -->
    <Style x:Key="TertiaryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushElevated}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushRed}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LargeActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="40" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  TEXTBOX — Terminal Input                                -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="DarkTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushVoid}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource BrushCyan}" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  COMBOBOX ITEMS                                         -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  CHECKBOX — Dark Themed                                     -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  TOGGLE SWITCH — iOS-style pill (Stitch Parity)         -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="track" Width="36" Height="20" CornerRadius="10"
                                Background="{StaticResource BrushOverlay}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <Canvas>
                                <Ellipse x:Name="knob" Width="14" Height="14" Canvas.Left="2" Canvas.Top="2"
                                         Fill="{StaticResource BrushTextMuted}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="knobTranslate" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource BrushCyanGlow}" />
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource BrushCyanDim}" />
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource BrushCyan}" />
                            <Setter TargetName="knobTranslate" Property="X" Value="16" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource BrushBorderEmphasis}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  FILTER PILL — ToggleButton pill for filter bars         -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="FilterPill" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="pill" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{StaticResource BrushCyanGlow}" />
                            <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource BrushCyan}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource BrushCyanDim}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  GLASS PANEL — Frosted glass simulation (WPF)          -->
    <!--  Approximates CSS backdrop-filter:blur(12px) using:    -->
    <!--  • Semi-transparent tinted background (72% opacity)    -->
    <!--  • Micro noise texture (DrawingBrush tile)             -->
    <!--  • Top-edge refraction highlight (light gradient)      -->
    <!--  • Gradient border (light-top, dark-bottom)            -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Noise texture tile: subtle 2×2 pixel grain pattern -->
    <DrawingBrush x:Key="FrostNoiseBrush" TileMode="Tile"
                  Viewport="0,0,4,4" ViewportUnits="Absolute"
                  Viewbox="0,0,4,4" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#03FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4,4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#05FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#04000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="2,1,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#06FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1,3,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#03000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,2,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Gradient border: top-light, bottom-dark (refraction simulation) -->
    <LinearGradientBrush x:Key="FrostBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40859397" Offset="0" />
        <GradientStop Color="#20859397" Offset="0.5" />
        <GradientStop Color="#10859397" Offset="1" />
    </LinearGradientBrush>

    <!-- Top-edge refraction highlight -->
    <LinearGradientBrush x:Key="FrostHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0CFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.15" />
    </LinearGradientBrush>

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="{StaticResource FrostBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource Surface}" Opacity="0.72" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- FrostedGlass: A full ContentControl that layers noise + highlight -->
    <Style x:Key="FrostedGlass" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- Layer 1: Semi-transparent tinted background -->
                        <Border x:Name="bgLayer" CornerRadius="12"
                                BorderBrush="{StaticResource FrostBorderBrush}" BorderThickness="1">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource Surface}" Opacity="0.72" />
                            </Border.Background>
                        </Border>

                        <!-- Layer 2: Noise grain overlay (frosted glass texture) -->
                        <Border CornerRadius="12" Opacity="0.5">
                            <Border.Background>
                                <DrawingBrush TileMode="Tile"
                                              Viewport="0,0,4,4" ViewportUnits="Absolute"
                                              Viewbox="0,0,4,4" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#03FFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,4,4" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#06FFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,1" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#04000000">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="2,1,1,1" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="#07FFFFFF">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="1,3,1,1" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.Background>
                        </Border>

                        <!-- Layer 3: Top-edge refraction highlight -->
                        <Border CornerRadius="12" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#0CFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.12" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Layer 4: Actual content -->
                        <ContentPresenter />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  PROGRESSBAR — Dark Themed                                -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
        <Setter Property="Height" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource BrushSurface}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushElevated}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanGlow}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  COMBOBOX — Dark Themed Dropdown                       -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushSurface}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Grid>
                                            <ContentPresenter x:Name="contentPresenter"
                                                              Margin="8,3,20,3"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"
                                                              Content="{TemplateBinding ComboBox.SelectionBoxItem}"
                                                              ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ComboBox.ItemTemplateSelector}" />
                                            <Path x:Name="arrow"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{StaticResource BrushTextMuted}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Width="10" Height="6"
                                                  Margin="0,0,6,0"
                                                  Stretch="Fill" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushCyanDim}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="arrow" Property="Fill" Value="{StaticResource BrushCyan}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="8,4,20,4"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False" />

                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Hidden"
                                 Background="{StaticResource BrushVoid}"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 BorderBrush="{StaticResource BrushBorder}"
                                 CaretBrush="{StaticResource BrushCyan}"
                                 SelectionBrush="{StaticResource BrushCyanGlow}"
                                 Margin="{TemplateBinding Padding}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    Background="{StaticResource BrushElevated}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter x:Name="ItemsPresenter"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  SCROLLBAR — 4px Cyan-Tinted (Stitch Parity)            -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent" Padding="0">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="4">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumb"
                                                    Background="#50859397"
                                                    CornerRadius="2"
                                                    BorderThickness="0" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{StaticResource BrushCyanDim}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumb" Property="Background" Value="{StaticResource BrushCyan}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="4" />
                <Setter Property="MinHeight" Value="4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  LISTBOX — Signal Edge Selection                        -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="DarkListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="0,0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent"
                            BorderThickness="1,1,1,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushElevated}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanGlow}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  NAVIGATION — Cyan Left-Accent Active                   -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2,0,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushElevated}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanGlow}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushCyan}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  TOOLTIP                                                -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource BrushOverlay}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  TERMINAL TEXTBOX                                       -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="TerminalTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushVoid}" />
        <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
        <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  DARK DATAGRID                                          -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="DarkDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BrushVoid}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BrushBase}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource BrushSurface}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushCyanGlow}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushElevated}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushCyanGlow}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  CARDS — Clean Surfaces, 1px Border                     -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <Style x:Key="AppleCard" TargetType="Border" BasedOn="{StaticResource GlassCard}" />
    <Style x:Key="DeviceCard" TargetType="Border" BasedOn="{StaticResource GlassCard}" />

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  UTILITY STYLES                                         -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="QuickActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushElevated}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushElevated}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontHeader}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    </Style>

    <Style x:Key="SeparatorLine" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushBorder}" />
        <Setter Property="Height" Value="1" />
    </Style>

    <Style x:Key="VerticalSeparator" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushBorder}" />
        <Setter Property="Width" Value="1" />
    </Style>

    <!-- Status Dots -->
    <Style x:Key="StatusDotOnline" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Fill" Value="{StaticResource BrushGreen}" />
    </Style>
    <Style x:Key="StatusDotOffline" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Fill" Value="{StaticResource BrushRed}" />
    </Style>
    <Style x:Key="StatusDotWarning" TargetType="Ellipse">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Fill" Value="{StaticResource BrushAmber}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!--  WINDOW CONTROL BUTTONS                                 -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <Style x:Key="WindowControlButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushElevated}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter Toggle Button — compact, themed -->
    <Style x:Key="FilterToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource FontPrimary}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushCyanGlow}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushCyan}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushCyan}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushCyanDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushRed}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
